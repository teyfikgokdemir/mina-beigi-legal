---
const { lang } = Astro.props;
const isTr = lang === "tr";

const nav = isTr ? [
  { name: "Ana Sayfa", href: "/tr/" },
  { name: "Hakkımızda", href: "/tr/hakkimizda" },
  { name: "Hizmetler", href: "/tr/hizmetler" },
  { name: "İletişim", href: "/tr/iletisim" },
] : [
  { name: "خانه", href: "/fa/" },
  { name: "درباره ما", href: "/fa/about" },
  { name: "خدمات", href: "/fa/services" },
  { name: "تماس با ما", href: "/fa/contact" },
];

const otherLang = isTr ? "fa" : "tr";
const otherLangName = isTr ? "FA" : "TR";

const routeMap = {
  "/tr/": "/fa/", "/fa/": "/tr/",
  "/tr/hakkimizda/": "/fa/about/", "/fa/about/": "/tr/hakkimizda/",
  "/tr/hizmetler/": "/fa/services/", "/fa/services/": "/tr/hizmetler/",
  "/tr/calisma-izni/": "/fa/work-permit/", "/fa/work-permit/": "/tr/calisma-izni/",
  "/tr/ogrenci-ikameti/": "/fa/student-residence/", "/fa/student-residence/": "/tr/ogrenci-ikameti/",
  "/tr/gayrimenkul-ikamet-vatandaslik/": "/fa/property-residence-citizenship/", "/fa/property-residence-citizenship/": "/tr/gayrimenkul-ikamet-vatandaslik/",
  "/tr/sirket-kurulusu/": "/fa/company-formation/", "/fa/company-formation/": "/tr/sirket-kurulusu/",
  "/tr/yatirim-danismanligi/": "/fa/investment-consulting/", "/fa/investment-consulting/": "/tr/yatirim-danismanligi/",
  "/tr/deport-ret-surecleri/": "/fa/deport-rejection/", "/fa/deport-rejection/": "/tr/deport-ret-surecleri/",
  "/tr/tercumanlik/": "/fa/translation/", "/fa/translation/": "/tr/tercumanlik/",
  "/tr/banka-vergi-finansal-surecler/": "/fa/banking-tax-financial-processes/", "/fa/banking-tax-financial-processes/": "/tr/banka-vergi-finansal-surecler/",
  "/tr/sss/": "/fa/faq/", "/fa/faq/": "/tr/sss/",
  "/tr/iletisim/": "/fa/contact/", "/fa/contact/": "/tr/iletisim/",
  "/tr/gizlilik/": "/fa/privacy/", "/fa/privacy/": "/tr/gizlilik/"
};

const getOtherLangPath = () => {
  let p = Astro.url.pathname;
  if (!p.endsWith("/")) p += "/";
  return routeMap[p] || (isTr ? "/fa/" : "/tr/");
};
---
<header class="sticky top-0 z-50 bg-primary/95 backdrop-blur-md border-b border-surface">
  <div class="container mx-auto px-4 py-5 flex justify-between items-center">
    <a href={`/${lang}/`} class="group inline-flex items-center" aria-label="Mina Beigi">
      <img src="/images/mina-beigi-logo.svg" alt="Mina Beigi International Consulting" class="h-10 md:h-11 w-auto object-contain transition-transform duration-300 group-hover:scale-[1.015]" />
    </a>
    
    <nav class="hidden md:flex gap-8 items-center" dir={isTr ? "ltr" : "rtl"}>
      {nav.map(item => (
        <a href={item.href} class="text-sm font-medium text-ivory hover:text-brand transition-colors">
          {item.name}
        </a>
      ))}
      <a href={getOtherLangPath()} class="px-4 py-1.5 text-xs font-semibold border border-surface text-bronze rounded hover:border-brand hover:text-brand transition-colors">
        {otherLangName}
      </a>
    </nav>
    
    <div class="md:hidden flex items-center gap-4">
      <a href={getOtherLangPath()} class="px-3 py-1.5 text-xs font-semibold border border-surface text-bronze rounded">
        {otherLangName}
      </a>
      <button class="text-ivory hover:text-brand transition-colors p-2 focus:outline-none" aria-label="Menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>
