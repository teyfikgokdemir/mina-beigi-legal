---
const { lang } = Astro.props;
const isTr = lang === "tr";

const nav = isTr ? [
  { name: "Ana Sayfa", href: "/tr/" },
  { name: "Hakkımızda", href: "/tr/hakkimizda/" },
  { name: "Hizmetler", href: "/tr/hizmetler/" },
  { name: "İletişim", href: "/tr/iletisim/" },
] : [
  { name: "خانه", href: "/fa/" },
  { name: "درباره ما", href: "/fa/about/" },
  { name: "خدمات", href: "/fa/services/" },
  { name: "تماس با ما", href: "/fa/contact/" },
];

const ctaText = isTr ? "Danışmanlık Talebi" : "درخواست مشاوره";
const ctaLink = isTr ? "/tr/iletisim/" : "/fa/contact/";

const otherLangLabel = isTr ? "Farsça" : "Türkçe";

const routeMap = {
  "/tr/": "/fa/", "/fa/": "/tr/",
  "/tr/hakkimizda/": "/fa/about/", "/fa/about/": "/tr/hakkimizda/",
  "/tr/hizmetler/": "/fa/services/", "/fa/services/": "/tr/hizmetler/",
  "/tr/calisma-izni/": "/fa/work-permit/", "/fa/work-permit/": "/tr/calisma-izni/",
  "/tr/ogrenci-ikameti/": "/fa/student-residence/", "/fa/student-residence/": "/tr/ogrenci-ikameti/",
  "/tr/gayrimenkul-ikamet-vatandaslik/": "/fa/property-residence-citizenship/", "/fa/property-residence-citizenship/": "/tr/gayrimenkul-ikamet-vatandaslik/",
  "/tr/sirket-kurulusu/": "/fa/company-formation/", "/fa/company-formation/": "/tr/sirket-kurulusu/",
  "/tr/yatirim-danismanligi/": "/fa/investment-consulting/", "/fa/investment-consulting/": "/tr/yatirim-danismanligi/",
  "/tr/deport-ret-surecleri/": "/fa/deport-rejection/", "/fa/deport-rejection/": "/tr/deport-ret-surecleri/",
  "/tr/tercumanlik/": "/fa/translation/", "/fa/translation/": "/tr/tercumanlik/",
  "/tr/banka-vergi-finansal-surecler/": "/fa/banking-tax-financial-processes/", "/fa/banking-tax-financial-processes/": "/tr/banka-vergi-finansal-surecler/",
  "/tr/sss/": "/fa/faq/", "/fa/faq/": "/tr/sss/",
  "/tr/iletisim/": "/fa/contact/", "/fa/contact/": "/tr/iletisim/",
  "/tr/gizlilik/": "/fa/privacy/", "/fa/privacy/": "/tr/gizlilik/",
  "/tr/blog/": "/fa/blog/", "/fa/blog/": "/tr/blog/"
};

const getOtherLangPath = () => {
  let p = Astro.url.pathname;
  if (!p.endsWith("/")) p += "/";
  return routeMap[p] || (isTr ? "/fa/" : "/tr/");
};
---
<header class="sticky top-0 z-50 bg-primary/95 backdrop-blur-xl border-b border-surface/50 shadow-sm transition-all duration-300">
  <div class="container mx-auto px-4 py-3 md:py-4 flex items-center justify-between gap-4">
    
    <!-- Logo -->
    <a href={`/${lang}/`} class="group inline-flex items-center flex-shrink-0" aria-label="Mina Beigi">
      <img src="/images/mina-beigi-logo.svg" alt="Mina Beigi International Consulting" class="h-10 md:h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-[1.03]" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-8 xl:gap-10" dir={isTr ? "ltr" : "rtl"}>
      {nav.map(item => (
        <a href={item.href} class="group relative text-[15px] font-medium text-ivory/90 hover:text-ivory transition-colors py-2">
          {item.name}
          <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left rounded-full"></span>
        </a>
      ))}
    </nav>

    <!-- Right Side Actions (Desktop) -->
    <div class="hidden lg:flex items-center gap-5">
      <!-- Language Switcher -->
      <a href={getOtherLangPath()} aria-label={otherLangLabel} title={otherLangLabel}
        class="inline-flex items-center justify-center w-10 h-10 border border-surface/80 rounded-full hover:border-brand/50 hover:bg-surface/50 hover:shadow-lg hover:shadow-brand/10 transition-all duration-300 group">
        {isTr ? (
          <svg viewBox="0 0 30 20" class="w-5 h-5 rounded-[2px] overflow-hidden opacity-90 group-hover:opacity-100 transition-opacity" aria-hidden="true">
            <rect width="30" height="6.67" y="0" fill="#239F40"/><rect width="30" height="6.66" y="6.67" fill="#fff"/><rect width="30" height="6.67" y="13.33" fill="#DA0000"/>
            <circle cx="15" cy="10" r="2.2" fill="none" stroke="#DA0000" stroke-width=".8"/><path d="M15 7.3v5.4M12.3 10h5.4" stroke="#DA0000" stroke-width=".7"/>
          </svg>
        ) : (
          <svg viewBox="0 0 30 20" class="w-5 h-5 rounded-[2px] overflow-hidden opacity-90 group-hover:opacity-100 transition-opacity" aria-hidden="true">
            <rect width="30" height="20" fill="#E30A17"/><circle cx="12" cy="10" r="5.2" fill="#fff"/><circle cx="13.8" cy="10" r="4.2" fill="#E30A17"/><polygon points="18.2,10 21,9.1 19.3,11.4 19.3,8.6 21,10.9" fill="#fff"/>
          </svg>
        )}
      </a>

      <!-- CTA Button -->
      <a href={ctaLink} class="inline-flex items-center justify-center bg-brand text-white text-[15px] font-semibold px-6 py-2.5 rounded-full shadow-lg shadow-brand/20 border border-brand/50 hover:bg-[#A33850] hover:-translate-y-0.5 hover:shadow-brand/40 transition-all duration-300">
        {ctaText}
      </a>
    </div>

    <!-- Mobile Menu Toggle -->
    <div class="lg:hidden flex items-center gap-3">
      <!-- Mobile Lang Switcher -->
      <a href={getOtherLangPath()} aria-label={otherLangLabel} title={otherLangLabel}
        class="inline-flex items-center justify-center w-9 h-9 border border-surface rounded-full hover:border-brand/50 transition-colors">
        {isTr ? (
          <svg viewBox="0 0 30 20" class="w-[18px] h-[12px] rounded-[2px] overflow-hidden" aria-hidden="true">
            <rect width="30" height="6.67" y="0" fill="#239F40"/><rect width="30" height="6.66" y="6.67" fill="#fff"/><rect width="30" height="6.67" y="13.33" fill="#DA0000"/>
            <circle cx="15" cy="10" r="2.2" fill="none" stroke="#DA0000" stroke-width=".8"/><path d="M15 7.3v5.4M12.3 10h5.4" stroke="#DA0000" stroke-width=".7"/>
          </svg>
        ) : (
          <svg viewBox="0 0 30 20" class="w-[18px] h-[12px] rounded-[2px] overflow-hidden" aria-hidden="true">
            <rect width="30" height="20" fill="#E30A17"/><circle cx="12" cy="10" r="5.2" fill="#fff"/><circle cx="13.8" cy="10" r="4.2" fill="#E30A17"/><polygon points="18.2,10 21,9.1 19.3,11.4 19.3,8.6 21,10.9" fill="#fff"/>
          </svg>
        )}
      </a>

      <button id="mobileMenuToggle" class="text-ivory hover:text-brand transition-colors p-2 focus:outline-none" aria-expanded="false" aria-controls="mobileMenu">
        <svg id="menuIconOpen" xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        <svg id="menuIconClose" class="hidden" xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="6" x2="18" y1="6" y2="18"/><line x1="18" x2="6" y1="6" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobileMenu" class="lg:hidden hidden border-t border-surface/50 bg-primary/98 backdrop-blur-xl absolute w-full left-0 shadow-2xl overflow-hidden origin-top">
    <nav class="container mx-auto px-6 py-6 flex flex-col gap-2" dir={isTr ? "ltr" : "rtl"}>
      {nav.map(item => (
        <a href={item.href} class="mobile-menu-link block text-lg font-medium text-ivory hover:text-brand transition-colors py-3 border-b border-surface/50">
          {item.name}
        </a>
      ))}
      <a href={ctaLink} class="mt-4 block w-full text-center bg-brand text-white text-base font-semibold px-6 py-3.5 rounded-xl shadow-lg hover:bg-[#A33850] transition-colors">
        {ctaText}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobileMenuToggle');
  const menu = document.getElementById('mobileMenu');
  const openIcon = document.getElementById('menuIconOpen');
  const closeIcon = document.getElementById('menuIconClose');

  const closeMenu = () => {
    menu?.classList.add('hidden');
    openIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded','false');
  };

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    if (isOpen) {
      closeMenu();
    } else {
      menu?.classList.remove('hidden');
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      toggle?.setAttribute('aria-expanded','true');
    }
  });

  document.querySelectorAll('.mobile-menu-link').forEach(link => link.addEventListener('click', closeMenu));
  window.addEventListener('resize', () => { if (window.innerWidth >= 1024) closeMenu(); });
</script>
