---
const { lang } = Astro.props;
const isTr = lang === "tr";
---
<footer class="bg-surface border-t border-primary pt-16 pb-8">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12" dir={isTr ? "ltr" : "rtl"}>
      <div class="col-span-1 md:col-span-2">
        <a href={`/${lang}/`} class="text-2xl font-bold text-ivory tracking-wide flex items-center gap-3 group mb-4">
          <span class="text-brand group-hover:text-rose transition-colors duration-300">MINA BEIGI</span>
          <span class="text-xs font-normal text-bronze border-s border-primary ps-3 ms-1 opacity-80">{isTr ? "International Consulting" : "مشاوره بین‌المللی"}</span>
        </a>
        <p class="text-ivory/60 text-sm max-w-sm leading-relaxed">
          {isTr ? "Türkiye'de Göçmenlik, Yatırım ve Resmî Süreçlerde Profesyonel Destek." : "پشتیبانی حرفه‌ای در امور مهاجرت، سرمایه‌گذاری و روندهای رسمی در ترکیه."}
        </p>
      </div>
      <div>
        <h4 class="text-ivory font-bold mb-4">{isTr ? "Hızlı Bağlantılar" : "لینک‌های سریع"}</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={isTr ? "/tr/hakkimizda" : "/fa/about"} class="text-ivory/70 hover:text-brand transition-colors">{isTr ? "Hakkımızda" : "درباره ما"}</a></li>
          <li><a href={isTr ? "/tr/hizmetler" : "/fa/services"} class="text-ivory/70 hover:text-brand transition-colors">{isTr ? "Hizmetler" : "خدمات"}</a></li>
          <li><a href={isTr ? "/tr/blog/" : "/fa/blog/"} class="text-ivory/70 hover:text-brand transition-colors">{isTr ? "Blog" : "مقالات"}</a></li>
          <li><a href={isTr ? "/tr/sss" : "/fa/faq"} class="text-ivory/70 hover:text-brand transition-colors">{isTr ? "SSS" : "سوالات متداول"}</a></li>
          <li><a href={isTr ? "/tr/iletisim" : "/fa/contact"} class="text-ivory/70 hover:text-brand transition-colors">{isTr ? "İletişim" : "تماس"}</a></li>
          <li><a href={isTr ? "/tr/gizlilik" : "/fa/privacy"} class="text-ivory/70 hover:text-brand transition-colors">{isTr ? "Gizlilik & KVKK" : "حریم خصوصی"}</a></li>
        </ul>
      </div>
    </div>
    
    <div class="flex flex-col md:flex-row justify-between items-center gap-6 pt-8 border-t border-primary" dir={isTr ? "ltr" : "rtl"}>
      <div class="text-ivory/60 text-sm">
        &copy; {new Date().getFullYear()} Mina Beigi. {isTr ? "Tüm hakları saklıdır." : "تمامی حقوق محفوظ است."}
      </div>
      <div class="flex items-center gap-6">
        <a href="https://www.instagram.com/mina_beigi_lawyer" target="_blank" aria-label="Instagram" class="text-bronze hover:text-brand transition-colors">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
