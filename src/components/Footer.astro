---
const { lang } = Astro.props;
const isTr = lang === "tr";

const serviceLinks = isTr ? [
  ["/tr/calisma-izni/","Çalışma İzni"],
  ["/tr/sirket-kurulusu/","Şirket Kuruluşu"],
  ["/tr/yatirim-danismanligi/","Yatırım Danışmanlığı"],
  ["/tr/banka-vergi-finansal-surecler/","Banka & Finans"],
] : [
  ["/fa/work-permit/","اجازه کار"],
  ["/fa/company-formation/","ثبت شرکت"],
  ["/fa/investment-consulting/","مشاوره سرمایه‌گذاری"],
  ["/fa/banking-tax-financial-processes/","بانک و امور مالی"],
];

const marqueeItems = isTr
  ? ["İstanbul","Tahran","Yatırım Danışmanlığı","Şirket Kuruluşu","Çalışma İzni","Resmî Tercümanlık","Gayrimenkul","İkamet ve Vatandaşlık","Banka & Finans"]
  : ["استانبول","تهران","مشاوره سرمایه‌گذاری","ثبت شرکت","اجازه کار","ترجمه رسمی","املاک","اقامت و شهروندی","بانک و امور مالی"];
---
<footer class="bg-primary/95 border-t border-ivory/5 pt-14 pb-8 relative overflow-hidden">
  
  <!-- Subtle Glow Effect in Footer -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl h-px bg-gradient-to-r from-transparent via-brand/40 to-transparent"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[300px] bg-brand/5 blur-[120px] pointer-events-none rounded-full"></div>

  <div class="container mx-auto px-4 relative z-10" dir={isTr ? "ltr" : "rtl"}>

    <div class={`footer-marquee mb-14 overflow-hidden rounded-xl border border-ivory/5 bg-surface/30 backdrop-blur-md ${isTr ? "is-tr" : "is-fa"}`} dir="ltr" aria-label={isTr ? "Hizmet başlıkları" : "خدمات ما"}>
      <div class="footer-marquee__track flex w-max items-center py-3 text-[0.78rem] md:text-sm font-medium tracking-wide text-bronze whitespace-nowrap">
        <div class="flex items-center shrink-0">
          {marqueeItems.map((item) => (
            <span class="inline-flex items-center">
              <span class="px-5 md:px-7" dir={isTr ? "ltr" : "rtl"}>{item}</span>
              <span class="text-brand/50">✦</span>
            </span>
          ))}
        </div>
        <div class="flex items-center shrink-0" aria-hidden="true">
          {marqueeItems.map((item) => (
            <span class="inline-flex items-center">
              <span class="px-5 md:px-7" dir={isTr ? "ltr" : "rtl"}>{item}</span>
              <span class="text-brand/50">✦</span>
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Elite Grid (Borderless) -->
    <div class="grid md:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr] gap-12 lg:gap-16 mb-16">
      
      <!-- Brand & Contact -->
      <div class="flex flex-col items-start">
        <a href={isTr ? "/tr/" : "/fa/"} class="inline-block mb-6 group">
          <img src="/images/mina-beigi-logo.svg" alt="Mina Beigi International Consulting" class="h-14 md:h-16 w-auto object-contain transition-transform duration-500 group-hover:scale-105" />
        </a>
        <p class="text-[0.95rem] text-ivory/60 leading-relaxed max-w-sm mb-8">
          {isTr
            ? "Türkiye–İran ekseninde göçmenlik, yatırım, şirket kuruluşu, resmî tercümanlık ve süreç koordinasyonu."
            : "خدمات مهاجرت، سرمایه‌گذاری، ثبت شرکت، ترجمه رسمی و هماهنگی روندها در محور ایران و ترکیه."}
        </p>

        <div class="flex flex-col sm:flex-row gap-6 sm:gap-12">
          <div>
            <h4 class="text-[0.65rem] uppercase tracking-[0.2em] text-bronze font-semibold mb-2">{isTr ? "Türkiye İletişim" : "تماس ترکیه"}</h4>
            <a href="tel:+905392425624" class="text-ivory hover:text-brand transition-colors text-[0.95rem] font-medium" dir="ltr">+90 539 2425 624</a>
          </div>
          <div>
            <h4 class="text-[0.65rem] uppercase tracking-[0.2em] text-bronze font-semibold mb-2">{isTr ? "İran İletişim" : "تماس ایران"}</h4>
            <a href="tel:+989125102088" class="text-ivory hover:text-brand transition-colors text-[0.95rem] font-medium" dir="ltr">+98 912 510 20 88</a>
          </div>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-[0.7rem] uppercase tracking-[0.18em] text-bronze font-semibold mb-6">{isTr ? "Hızlı Bağlantılar" : "لینک‌های سریع"}</h3>
        <ul class="space-y-3.5 text-[0.9rem]">
          <li><a href={isTr ? "/tr/hakkimizda/" : "/fa/about/"} class="group inline-flex items-center text-ivory/60 hover:text-ivory transition-colors"><span class="w-1.5 h-1.5 rounded-full bg-brand/0 group-hover:bg-brand transition-all mr-2 rtl:mr-0 rtl:ml-2"></span>{isTr ? "Hakkımızda" : "درباره ما"}</a></li>
          <li><a href={isTr ? "/tr/hizmetler/" : "/fa/services/"} class="group inline-flex items-center text-ivory/60 hover:text-ivory transition-colors"><span class="w-1.5 h-1.5 rounded-full bg-brand/0 group-hover:bg-brand transition-all mr-2 rtl:mr-0 rtl:ml-2"></span>{isTr ? "Hizmetler" : "خدمات"}</a></li>
          <li><a href={isTr ? "/tr/blog/" : "/fa/blog/"} class="group inline-flex items-center text-ivory/60 hover:text-ivory transition-colors"><span class="w-1.5 h-1.5 rounded-full bg-brand/0 group-hover:bg-brand transition-all mr-2 rtl:mr-0 rtl:ml-2"></span>{isTr ? "Blog" : "مقالات"}</a></li>
          <li><a href={isTr ? "/tr/sss/" : "/fa/faq/"} class="group inline-flex items-center text-ivory/60 hover:text-ivory transition-colors"><span class="w-1.5 h-1.5 rounded-full bg-brand/0 group-hover:bg-brand transition-all mr-2 rtl:mr-0 rtl:ml-2"></span>{isTr ? "SSS" : "سوالات متداول"}</a></li>
          <li><a href={isTr ? "/tr/iletisim/" : "/fa/contact/"} class="group inline-flex items-center text-ivory/60 hover:text-ivory transition-colors"><span class="w-1.5 h-1.5 rounded-full bg-brand/0 group-hover:bg-brand transition-all mr-2 rtl:mr-0 rtl:ml-2"></span>{isTr ? "İletişim" : "تماس با ما"}</a></li>
          <li><a href={isTr ? "/tr/gizlilik/" : "/fa/privacy/"} class="group inline-flex items-center text-ivory/60 hover:text-ivory transition-colors"><span class="w-1.5 h-1.5 rounded-full bg-brand/0 group-hover:bg-brand transition-all mr-2 rtl:mr-0 rtl:ml-2"></span>{isTr ? "Gizlilik & KVKK" : "حریم خصوصی"}</a></li>
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-[0.7rem] uppercase tracking-[0.18em] text-bronze font-semibold mb-6">{isTr ? "Öne Çıkan Hizmetler" : "خدمات برجسته"}</h3>
        <ul class="space-y-3.5 text-[0.9rem]">
          {serviceLinks.map(([href,label]) => (
            <li>
              <a href={href} class="group inline-flex items-center text-ivory/60 hover:text-ivory transition-all">
                <span class="w-1.5 h-1.5 rounded-full bg-brand/0 group-hover:bg-brand transition-all mr-2 rtl:mr-0 rtl:ml-2"></span>
                {label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-8">
           <a href="https://www.instagram.com/mina_beigi_lawyer" target="_blank" aria-label="Instagram" class="w-10 h-10 inline-flex items-center justify-center rounded-full border border-ivory/10 text-ivory/60 hover:text-brand hover:border-brand hover:bg-brand/10 transition-all duration-300">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Strip -->
    <div class="pt-6 border-t border-ivory/10 flex flex-col md:flex-row justify-between items-center gap-4 text-[0.8rem] text-ivory/40 font-medium">
      <div>&copy; {new Date().getFullYear()} Mina Beigi. {isTr ? "Tüm hakları saklıdır." : "تمام حقوق محفوظ است."}</div>
      <div class="flex items-center gap-6">
        <span>{isTr ? "Web sitesi " : "طراحی سایت "} <a href="https://qctcommerce.com/" target="_blank" rel="noopener noreferrer" class="text-bronze/80 hover:text-bronze transition-colors">QCT Commerce</a> {isTr ? " tarafından hazırlanmıştır." : ""}</span>
        <span class="hidden md:inline-block w-1 h-1 rounded-full bg-ivory/20"></span>
        <span class="hidden md:inline-block tracking-widest uppercase text-[0.65rem]">{isTr ? "İstanbul • Tahran" : "استانبول • تهران"}</span>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer-marquee__track {
    animation: footerMarquee 34s linear infinite;
    will-change: transform;
    direction: ltr;
  }
  .footer-marquee.is-fa .footer-marquee__track {
    animation-direction: reverse;
  }
  .footer-marquee:hover .footer-marquee__track {
    animation-play-state: paused;
  }
  @keyframes footerMarquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-marquee__track {
      animation: none;
      transform: none;
    }
  }
</style>
