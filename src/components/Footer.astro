---
const { lang } = Astro.props;
const isTr = lang === "tr";
---
<footer class="bg-surface border-t border-primary pt-16 pb-8">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row justify-between items-center gap-6" dir={isTr ? "ltr" : "rtl"}>
      <div class="text-ivory/60 text-sm">
        &copy; {new Date().getFullYear()} Mina Beigi. {isTr ? "Tüm hakları saklıdır." : "تمامی حقوق محفوظ است."}
      </div>
      <div class="flex items-center gap-6">
        <a href={isTr ? "/tr/gizlilik" : "/fa/privacy"} class="text-sm text-bronze hover:text-brand transition-colors">
          {isTr ? "Gizlilik ve KVKK" : "حریم خصوصی"}
        </a>
        <a href="https://www.instagram.com/mina_beigi_lawyer" target="_blank" aria-label="Instagram" class="text-bronze hover:text-brand transition-colors">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
