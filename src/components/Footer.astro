---
const { lang } = Astro.props;
const isTr = lang === "tr";

const serviceLinks = isTr ? [
  ["/tr/calisma-izni/","Çalışma İzni"],
  ["/tr/sirket-kurulusu/","Şirket Kuruluşu"],
  ["/tr/yatirim-danismanligi/","Yatırım Danışmanlığı"],
  ["/tr/banka-vergi-finansal-surecler/","Banka & Finans"],
] : [
  ["/fa/work-permit/","مجوز کار"],
  ["/fa/company-formation/","ثبت شرکت"],
  ["/fa/investment-consulting/","سرمایه‌گذاری"],
  ["/fa/banking-tax-financial-processes/","بانک و امور مالی"],
];

const marqueeItems = isTr
  ? ["İstanbul","Tahran","Yatırım Danışmanlığı","Şirket Kuruluşu","Çalışma İzni","Resmî Tercümanlık","Gayrimenkul","İkamet ve Vatandaşlık","Banka & Finans"]
  : ["استانبول","تهران","مشاوره سرمایه‌گذاری","ثبت شرکت","مجوز کار","ترجمه رسمی","خرید ملک","اقامت و شهروندی","بانک و امور مالی"];
---
<footer class="bg-surface border-t border-primary/80">
  <div class="container mx-auto px-4 pt-10 md:pt-12 pb-10" dir={isTr ? "ltr" : "rtl"}>

    <div class={`footer-marquee mb-6 overflow-hidden rounded-xl border border-primary/80 bg-primary/35 ${isTr ? "is-tr" : "is-fa"}`} dir="ltr" aria-label={isTr ? "Hizmet başlıkları" : "عناوین خدمات"}>
      <div class="footer-marquee__track flex w-max items-center py-3 text-[0.78rem] md:text-sm font-medium tracking-wide text-bronze whitespace-nowrap">
        <div class="flex items-center shrink-0">
          {marqueeItems.map((item) => (
            <span class="inline-flex items-center">
              <span class="px-5 md:px-7" dir={isTr ? "ltr" : "rtl"}>{item}</span>
              <span class="text-brand/80">◆</span>
            </span>
          ))}
        </div>
        <div class="flex items-center shrink-0" aria-hidden="true">
          {marqueeItems.map((item) => (
            <span class="inline-flex items-center">
              <span class="px-5 md:px-7" dir={isTr ? "ltr" : "rtl"}>{item}</span>
              <span class="text-brand/80">◆</span>
            </span>
          ))}
        </div>
      </div>
    </div>

    <div class="grid lg:grid-cols-[2.1fr_0.9fr_0.9fr] gap-6 lg:gap-8 items-stretch">
      <div class="rounded-2xl border border-primary bg-primary/35 p-6 h-full">
        <div class="flex items-center justify-center relative">
          <a href={isTr ? "/tr/" : "/fa/"} class="inline-flex items-center">
            <img src="/images/mina-beigi-logo.svg" alt="Mina Beigi International Consulting" class="h-14 md:h-16 w-auto object-contain" />
          </a>
          <a href="https://www.instagram.com/mina_beigi_lawyer" target="_blank" aria-label="Instagram" class="w-10 h-10 inline-flex items-center justify-center rounded-full border border-primary text-bronze hover:text-brand hover:border-brand transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
        </div>

        <p class="mt-4 text-sm text-ivory/60 leading-relaxed text-center mx-auto">
          {isTr
            ? "Türkiye–İran ekseninde göçmenlik, yatırım, şirket kuruluşu, resmî tercümanlık ve süreç koordinasyonu."
            : "همراهی حرفه‌ای در امور مهاجرتی، سرمایه‌گذاری، ثبت شرکت، ترجمه رسمی و هماهنگی فرآیندها میان ایران و ترکیه."}
        </p>

        <div class="mt-6 grid sm:grid-cols-2 gap-3">
          <a href="tel:+905392425624" class="group rounded-xl border border-primary bg-surface/70 p-4 hover:border-brand transition-colors">
            <span class="block text-xs uppercase tracking-wide text-brand font-semibold mb-1">{isTr ? "Türkiye İletişim" : "تماس ترکیه"}</span>
            <span class="text-sm text-ivory/80 group-hover:text-ivory" dir="ltr">+90 539 2425 624</span>
          </a>
          <a href="tel:+989125102088" class="group rounded-xl border border-primary bg-surface/70 p-4 hover:border-brand transition-colors">
            <span class="block text-xs uppercase tracking-wide text-brand font-semibold mb-1">{isTr ? "İran İletişim" : "تماس ایران"}</span>
            <span class="text-sm text-ivory/80 group-hover:text-ivory" dir="ltr">+98 912 510 20 88</span>
          </a>
        </div>
      </div>

      <div class="rounded-2xl border border-primary bg-primary/20 p-6 h-full">
        <h2 class="text-xs uppercase tracking-[0.18em] text-ivory font-semibold mb-4">{isTr ? "Hızlı Bağlantılar" : "دسترسی سریع"}</h2>
        <div class="grid grid-cols-2 gap-x-5 gap-y-3 text-sm">
          <a href={isTr ? "/tr/hakkimizda/" : "/fa/about/"} class="text-ivory/60 hover:text-brand transition-colors">{isTr ? "Hakkımızda" : "درباره ما"}</a>
          <a href={isTr ? "/tr/hizmetler/" : "/fa/services/"} class="text-ivory/60 hover:text-brand transition-colors">{isTr ? "Hizmetler" : "خدمات"}</a>
          <a href={isTr ? "/tr/blog/" : "/fa/blog/"} class="text-ivory/60 hover:text-brand transition-colors">{isTr ? "Blog" : "مقالات"}</a>
          <a href={isTr ? "/tr/sss/" : "/fa/faq/"} class="text-ivory/60 hover:text-brand transition-colors">{isTr ? "SSS" : "سوالات متداول"}</a>
          <a href={isTr ? "/tr/iletisim/" : "/fa/contact/"} class="text-ivory/60 hover:text-brand transition-colors">{isTr ? "İletişim" : "تماس با ما"}</a>
          <a href={isTr ? "/tr/gizlilik/" : "/fa/privacy/"} class="text-ivory/60 hover:text-brand transition-colors">{isTr ? "Gizlilik & KVKK" : "حریم خصوصی"}</a>
        </div>
      </div>

      <div class="rounded-2xl border border-primary bg-primary/20 p-6 h-full">
        <h2 class="text-xs uppercase tracking-[0.18em] text-ivory font-semibold mb-4">{isTr ? "Öne Çıkan Hizmetler" : "خدمات منتخب"}</h2>
        <div class="space-y-3 text-sm">
          {serviceLinks.map(([href,label]) => (
            <a href={href} class="flex items-center justify-between gap-3 text-ivory/60 hover:text-brand transition-colors">
              <span>{label}</span><span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-5 pt-5 border-t border-primary/80 grid md:grid-cols-3 gap-3 items-center text-xs">
      <span class="text-ivory/70 text-center md:text-start md:pl-20 font-medium">&copy; {new Date().getFullYear()} Mina Beigi. {isTr ? "Tüm hakları saklıdır." : "تمامی حقوق محفوظ است."}</span>
      <div class="text-center text-ivory/50">
        {isTr ? "Web sitesi " : "طراحی و توسعه توسط "}
        <a href="https://qctcommerce.com/" target="_blank" rel="noopener noreferrer" class="text-bronze hover:text-brand transition-colors font-medium">QCT Commerce</a>
        {isTr ? " tarafından hazırlanmıştır." : ""}
      </div>
      <span class="text-ivory/50 md:text-end text-center">{isTr ? "İstanbul • Tahran" : "استانبول • تهران"}</span>
    </div>
  </div>
</footer>

<style>
  .footer-marquee__track {
    animation: footerMarquee 34s linear infinite;
    will-change: transform;
    direction: ltr;
  }
  .footer-marquee.is-fa .footer-marquee__track {
    animation-direction: reverse;
  }
  .footer-marquee:hover .footer-marquee__track {
    animation-play-state: paused;
  }
  @keyframes footerMarquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-marquee__track {
      animation: none;
      transform: none;
    }
  }
</style>
