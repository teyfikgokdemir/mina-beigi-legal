---
const { lang } = Astro.props;
const isTr = lang === 'tr';

const msg = isTr
  ? 'Merhaba, danışmanlık hizmetleriniz hakkında bilgi almak istiyorum.'
  : 'سلام، می‌خواستم درباره خدمات مشاوره شما اطلاعات کسب کنم.';

const waUrlTr = `https://wa.me/905392425624?text=${encodeURIComponent(msg)}`;
const waUrlIr = `https://wa.me/989125102088?text=${encodeURIComponent(msg)}`;

const trOption = { name: isTr ? 'Türkiye WhatsApp' : 'واتساپ ترکیه', url: waUrlTr, flag: '🇹🇷', num: '+90 539 2425 624' };
const irOption = { name: isTr ? 'İran WhatsApp' : 'واتساپ ایران', url: waUrlIr, flag: '🇮🇷', num: '+98 912 510 20 88' };
const options = isTr ? [trOption, irOption] : [irOption, trOption];
---
<div id="waFloat" class="fixed bottom-5 left-5 md:bottom-6 md:left-6 z-50 flex flex-col items-start opacity-0 pointer-events-none translate-y-2 transition-all duration-300">
  <div id="waMenu" class="hidden mb-3 bg-surface border border-primary shadow-2xl rounded-xl overflow-hidden min-w-[250px] flex-col">
    <div class="p-3 bg-brand text-ivory font-bold text-center">{isTr ? 'İletişime Geçin' : 'تماس با ما'}</div>
    {options.map((opt, i) => (
      <a href={opt.url} target="_blank" class={`flex items-center gap-4 p-4 hover:bg-primary transition-colors ${i === 0 ? 'border-b border-primary' : ''}`} dir={isTr ? "ltr" : "rtl"}>
        <span class="text-2xl">{opt.flag}</span>
        <div class="flex flex-col">
          <span class="text-ivory text-sm font-semibold">{opt.name}</span>
          <span class="text-bronze text-xs mt-1" dir="ltr">{opt.num}</span>
        </div>
      </a>
    ))}
  </div>
  <button id="waToggle" class="pointer-events-auto bg-[#25D366] text-white w-14 h-14 inline-flex items-center justify-center rounded-full shadow-xl hover:scale-105 transition-transform focus:outline-none" aria-label="WhatsApp">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/></svg>
  </button>
</div>

<script>
  const wrap = document.getElementById('waFloat');
  const toggle = document.getElementById('waToggle');
  const menu = document.getElementById('waMenu');
  let fadeTimer;

  const reveal = () => {
    if (!wrap) return;
    if (window.scrollY > 120) {
      wrap.classList.remove('opacity-0','pointer-events-none','translate-y-2');
      wrap.classList.add('opacity-100');
      clearTimeout(fadeTimer);
      fadeTimer = setTimeout(() => {
        if (!menu?.classList.contains('flex')) wrap.classList.add('opacity-60');
      }, 3500);
    } else {
      wrap.classList.add('opacity-0','pointer-events-none','translate-y-2');
      wrap.classList.remove('opacity-100','opacity-60');
    }
  };

  window.addEventListener('scroll', reveal, { passive: true });
  window.addEventListener('load', reveal);

  toggle?.addEventListener('click', () => {
    wrap?.classList.remove('opacity-60');
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
  });

  wrap?.addEventListener('mouseenter', () => wrap.classList.remove('opacity-60'));

  document.addEventListener('click', (e) => {
    if (!toggle?.contains(e.target) && !menu?.contains(e.target)) {
      menu?.classList.add('hidden');
      menu?.classList.remove('flex');
    }
  });
</script>
