---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const title = "Türkiye'de Yaşam, Yatırım ve Resmî Süreçler";
const description = "Çalışma izni, ikamet, şirket kuruluşu, yatırım, gayrimenkul, bankacılık ve yabancıların Türkiye'de karşılaştığı güncel süreçlere ilişkin kapsamlı rehberler.";
---

<BaseLayout title={title} description={description} lang="tr">
  <section class="relative py-20 bg-primary overflow-hidden">
    <div class="container mx-auto px-4 relative z-20 text-center max-w-4xl">
      <h1 class="text-3xl md:text-5xl font-bold mb-6 text-ivory leading-tight tracking-tight">
        {title}
      </h1>
      <p class="text-lg text-ivory/70 mb-0 mx-auto font-light leading-relaxed">
        {description}
      </p>
    </div>
  </section>

  <section class="py-16 bg-surface border-y border-primary">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- Blog 1 -->
        <a href="/tr/blog/2026-turkiye-calisma-izni-kriterleri/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <img src="/images/blog-1.jpg" alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">Çalışma İzni</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">2026 Türkiye Çalışma İzni Kriterleri Değişti: Yeni Kurallar ve Muafiyetler</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">3 Ağustos 2026 itibarıyla yürürlüğe giren yeni değerlendirme kriterleri, istisnalar ve İran vatandaşları açısından pratik senaryolar.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>Son güncelleme: Eylül 2026</span>
              <span class="text-brand font-medium">Devamını Oku &rarr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 2 -->
        <a href="/tr/blog/2026-turkiye-calisma-izni-muafiyeti/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <img src="/images/blog-2.jpg" alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">Muafiyet</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">Türkiye’de Çalışma İzni Muafiyeti 2026: Yeni Sistem</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">17 Eylül 2026 sistem değişikliği, çalışma izni ile çalışma izni muafiyeti arasındaki fark ve kimlerin muafiyet kapsamında değerlendirilebileceği.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>Son güncelleme: Eylül 2026</span>
              <span class="text-brand font-medium">Devamını Oku &rarr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 3 -->
        <a href="/tr/blog/iranlilar-sirket-kurunca-calisma-izni-alir-mi/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <img src="/images/blog-3.jpg" alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">Şirket Kuruluşu</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">İranlılar Türkiye’de Şirket Kurunca Çalışma İzni veya İkamet Alır mı?</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">Şirket kurmanın tek başına sağladıkları, sermaye yapısı, güncel kriterler ve İranlı yatırımcıların sık yaptığı hatalar.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>Son güncelleme: Eylül 2026</span>
              <span class="text-brand font-medium">Devamını Oku &rarr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 4 -->
        <a href="/tr/blog/iranlilar-turkiyede-banka-hesabi-acabilir-mi/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <img src="/images/blog-4.jpg" alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">Bankacılık</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">İranlılar Türkiye’de Banka Hesabı Açabilir mi? 2026 Rehberi</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">Bireysel ve şirket hesapları, vergi numarası, KYC gereklilikleri, para transferleri ve uluslararası uyum/yaptırım kontrolleri.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>Son güncelleme: Eylül 2026</span>
              <span class="text-brand font-medium">Devamını Oku &rarr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 5 -->
        <a href="/tr/blog/turkiyede-ev-alarak-vatandaslik-2026/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <img src="/images/blog-5.jpg" alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">Vatandaşlık</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">Türkiye’de Ev Alarak Vatandaşlık 2026: 400.000 Dolar Şartı</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">400.000 USD eşik, tapu ve 3 yıl satmama kuralı, ekspertiz/değerleme ve yaygın yatırımcı hataları.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>Son güncelleme: Eylül 2026</span>
              <span class="text-brand font-medium">Devamını Oku &rarr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 6 -->
        <a href="/tr/blog/turkiyede-ikamet-izni-2026/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <img src="/images/blog-6.jpg" alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">İkamet İzni</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">Türkiye’de İkamet İzni 2026: E-İkamet ve Başvuru Süreci</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">E-ikamet sistemi, gayrimenkul ve iş bağlantısı, mali yeterlilik, başvuru süreleri ve İranlılar için hazırlık rehberi.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>Son güncelleme: Eylül 2026</span>
              <span class="text-brand font-medium">Devamını Oku &rarr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 7 -->
        <a href="/tr/blog/turkiyede-ogrenci-ikameti-ve-calisma-hakki/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <img src="/images/blog-7.jpg" alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">Eğitim & İkamet</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">Türkiye’de Öğrenci İkameti ve Çalışma Hakkı 2026</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">Yabancı öğrenciler için ikamet başvuru koşulları, okul değiştirme süreçleri, çalışma hakları ve mezuniyet sonrası statü.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>Son güncelleme: Eylül 2026</span>
              <span class="text-brand font-medium">Devamını Oku &rarr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 8 -->
        <a href="/tr/blog/turkiyede-deport-giriş-yasagi-ikamet-reddi/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <img src="/images/blog-8.jpg" alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">Hukuki Süreçler</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">Türkiye’de Deport, Giriş Yasağı ve İkamet Reddi Süreçleri</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">Tahdit kodları, sınır dışı kararları, ikamet reddi durumlarında tebliğ süreleri ve hukuki temsil süreçlerinin incelenmesi.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>Son güncelleme: Eylül 2026</span>
              <span class="text-brand font-medium">Devamını Oku &rarr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 9 -->
        <a href="/tr/blog/istanbul-ve-turkiyede-fabrika-kurmak-2026/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <img src="/images/blog-9.jpg" alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">Yatırım & Üretim</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">İstanbul ve Türkiye’de Fabrika Kurmak: Yabancı Yatırımcı Rehberi</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">Sanayi bölgeleri (OSB), üretim izinleri, ruhsatlar, çalışma izni istisnaları ve fabrika kuruluş süreçleri.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>Son güncelleme: Eylül 2026</span>
              <span class="text-brand font-medium">Devamını Oku &rarr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 10 -->
        <a href="/tr/blog/iranli-yatirimcilar-icin-turkiyede-is-kurma-rehberi-2026-2027/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <img src="/images/blog-10.jpg" alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">Rehber</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">İranlı Yatırımcılar İçin Türkiye’de İş Kurma Rehberi 2026–2027</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">Şirket türleri, MERSİS, E-TUYS, ticaret sicili, banka, vergi, izinler ve operasyon öncesi checklist.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>Son güncelleme: Eylül 2026</span>
              <span class="text-brand font-medium">Devamını Oku &rarr;</span>
            </div>
          </div>
        </a>

      </div>
    </div>
  </section>
</BaseLayout>
