---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { SITE_URL } from '../../consts';

const faq = [
  { q: 'İlk görüşme için hangi bilgileri hazırlamalıyım?', a: 'İşlem türünüz, mevcut durumunuz, hedefiniz, varsa başvuru veya karar belgeleri ve temel kimlik bilgileri ön değerlendirme için yeterlidir.' },
  { q: 'Türkçe bilmiyorum, Farsça iletişim kurabilir miyim?', a: 'Evet. Farsça ve Türkçe iletişim mümkündür.' },
  { q: 'WhatsApp üzerinden dosya gönderebilir miyim?', a: 'İlk değerlendirme için temel belge ve bilgileri paylaşabilirsiniz. Hassas kişisel belgeler için gerekli görülürse daha uygun paylaşım yöntemi ayrıca belirtilir.' },
  { q: 'Ne kadar sürede dönüş yapılıyor?', a: 'Yoğunluğa göre değişmekle birlikte başvurular mümkün olan en kısa sürede incelenir. Kesin bir süre garantisi verilmez.' }
];
---
<BaseLayout title="İletişim | Mina Beigi" description="İstanbul ve Tahran iletişim bilgileri, Türkiye ve İran WhatsApp hatları, danışmanlık talep formu ve ön değerlendirme süreci." lang="tr">
  <Fragment slot="head">
    <link rel="canonical" href={SITE_URL + "/tr/iletisim/"} />
    <link rel="alternate" hreflang="tr" href={SITE_URL + "/tr/iletisim/"} />
    <link rel="alternate" hreflang="fa" href={SITE_URL + "/fa/contact/"} />
    <link rel="alternate" hreflang="x-default" href={SITE_URL + "/tr/iletisim/"} />
  </Fragment>

  <section class="relative py-12 md:py-9 md:py-10 bg-surface border-b border-primary overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/istanbul-bg.webp')] bg-cover bg-center opacity-25"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/65 to-primary/45"></div>
    <div class="container mx-auto px-4 max-w-5xl text-center relative z-10">
      <p class="text-brand text-sm font-semibold mb-2">İstanbul • Tahran</p>
      <h1 class="text-3xl md:text-4xl font-bold text-ivory mb-3">İletişim</h1>
      <p class="text-base md:text-lg text-ivory/75 max-w-3xl mx-auto">Göçmenlik, yatırım, şirket kuruluşu, gayrimenkul, resmî tercümanlık veya diğer resmî süreçlerle ilgili durumunuzu paylaşın; ilk değerlendirme için gerekli başlıkları birlikte netleştirelim.</p>
    </div>
  </section>

  <section class="py-8 md:py-10 bg-primary">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-6 lg:gap-8 items-start">
        <div class="space-y-3">
          <div class="grid sm:grid-cols-2 lg:grid-cols-1 gap-4">
            <div class="bg-surface rounded-xl border border-primary p-4 md:p-5">
              <span class="text-brand text-sm font-semibold">Türkiye</span>
              <h2 class="text-xl font-bold text-ivory mt-1 mb-1">İstanbul / Pendik</h2>
              <a href="tel:+905392425624" class="block text-ivory/80 hover:text-brand transition-colors">+90 539 2425 624</a>
              <a href="https://wa.me/905392425624" target="_blank" class="inline-flex mt-2 text-[#25D366] font-semibold">WhatsApp Türkiye →</a>
            </div>
            <div class="bg-surface rounded-xl border border-primary p-4 md:p-5">
              <span class="text-brand text-sm font-semibold">İran</span>
              <h2 class="text-xl font-bold text-ivory mt-1 mb-1">Tahran</h2>
              <a href="tel:+989125102088" class="block text-ivory/80 hover:text-brand transition-colors" dir="ltr">+98 912 510 20 88</a>
              <a href="https://wa.me/989125102088" target="_blank" class="inline-flex mt-2 text-[#25D366] font-semibold">WhatsApp İran →</a>
            </div>
          </div>

          <div class="bg-surface rounded-xl border border-primary p-4 md:p-5">
            <h2 class="text-lg font-bold text-ivory mb-2">Hangi konular için ulaşabilirsiniz?</h2>
            <ul class="space-y-2 text-ivory/70 text-sm">
              <li>• Çalışma izni ve öğrenci ikameti</li>
              <li>• Şirket kuruluşu ve yatırım süreçleri</li>
              <li>• Gayrimenkul, ikamet ve vatandaşlık dosyaları</li>
              <li>• Deport / ret dosyalarının ön değerlendirmesi</li>
              <li>• Farsça–Türkçe resmî tercümanlık</li>
              <li>• Banka hesabı, vergi numarası ve finansal işlem hazırlığı</li>
            </ul>
          </div>

          <div class="bg-surface rounded-xl border border-primary p-4 md:p-5">
            <h2 class="text-lg font-bold text-ivory mb-2">Instagram</h2>
            <a href="https://www.instagram.com/mina_beigi_lawyer" target="_blank" class="inline-flex items-center gap-3 text-bronze hover:text-brand transition-colors">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              @mina_beigi_lawyer
            </a>
          </div>
        </div>

        <div>
          <div class="mb-4">
            <h2 class="text-2xl font-bold text-ivory mb-2">Danışmanlık Talebi</h2>
            <p class="text-ivory/70">Durumunuzu mümkün olduğunca kısa ve net anlatın. Form gönderildikten sonra dosyanın hangi hizmet başlığı altında değerlendirilmesi gerektiği belirlenir.</p>
          </div>
          <ContactForm lang="tr" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 bg-surface border-t border-primary">
    <div class="container mx-auto px-4 max-w-5xl">
      <h2 class="text-2xl font-bold text-ivory text-center mb-5">İletişim Hakkında Sık Sorulan Sorular</h2>
      <div class="grid md:grid-cols-2 gap-4">
        {faq.map(item => (
          <details class="bg-primary border border-surface rounded-xl p-4">
            <summary class="font-semibold text-ivory cursor-pointer">{item.q}</summary>
            <p class="mt-3 text-sm text-ivory/70">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
