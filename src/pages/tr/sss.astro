---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_URL } from "../../consts";

const faqs = [
  {
    q: "Mina Beigi Uluslararası Danışmanlık hangi alanlarda hizmet veriyor?",
    a: "Türkiye'de şirket kuruluşu, çalışma ve ikamet izni süreçleri, yatırım danışmanlığı, uluslararası banka hesabı açılışı, gayrimenkul ve vatandaşlık süreçleri ile yeminli tercümanlık alanlarında hizmet veriyoruz."
  },
  {
    q: "İranlı yatırımcılar için özel finansal ve bankacılık danışmanlığı sağlıyor musunuz?",
    a: "Evet. Özellikle İran vatandaşlarının Türkiye'de karşılaştığı banka hesabı açılışı, şirket sermayesi transferleri ve uluslararası para transferleri (Compliance / Uyum süreçleri) gibi konularda, yasal çerçeveye uygun özel danışmanlık hizmeti vererek süreçlerin sorunsuz ilerlemesini sağlıyoruz."
  },
  {
    q: "İran vatandaşları Türkiye'de şirket kurduğunda otomatik olarak çalışma izni alır mı?",
    a: "Hayır, şirket kuruluşu ile çalışma izni tamamen farklı hukuki süreçlerdir. Şirket ortağı veya müdürü olmanız otomatik çalışma izni hakkı doğurmaz. Çalışma izni alabilmek için işletmenin sermaye, ciro ve Türk vatandaşı istihdamı gibi belirli yasal kriterleri karşılaması gerekmektedir. Uzmanlarımız bu planlamayı sizin için en başından yapar."
  },
  {
    q: "Deport (sınır dışı) veya ikamet izni reddi durumlarında hukuki destek sağlıyor musunuz?",
    a: "Evet. İkamet izni reddi, Türkiye'ye giriş yasağı (Tahdit kodları - örneğin G-87, Ç-114, V-84 vb.) ve sınır dışı kararlarına karşı, idari itirazların yapılması ve yetkili idare mahkemelerinde iptal davalarının açılması süreçlerini uzman avukat kadromuzla yürütmekteyiz."
  },
  {
    q: "Türkiye'de gayrimenkul alarak vatandaşlık başvurusunda bulunmak ne kadar sürer?",
    a: "Güncel mevzuata göre 400.000 USD değerinde gayrimenkul yatırımı yapan yabancılar istisnai olarak Türk vatandaşlığına başvurabilir. Başvuru öncesi uygunluk belgesinin (Uygunluk Belgesi) alınması, ikamet izni ve asıl vatandaşlık başvurusu adımları ortalama 4 ila 6 ay arasında sonuçlanmaktadır."
  },
  {
    q: "Süreçler için ne kadar süre öngörüyorsunuz?",
    a: "Süreçlerin tamamlanma süresi talep edilen hizmetin türüne ve resmi makamların yoğunluğuna göre değişiklik gösterir. Örneğin şirket kuruluşu birkaç gün içinde tamamlanabilirken, çalışma izni süreçleri haftalar, vatandaşlık başvuruları ise aylar sürebilir. İlk görüşmemizde size net bir zaman çizelgesi sunuyoruz."
  },
  {
    q: "Danışmanlık ücretleriniz nasıl belirleniyor?",
    a: "Ücretlendirmemiz, almak istediğiniz hizmetin kapsamına, sürecin karmaşıklığına ve gerekli operasyonel adımlara (örneğin yeminli tercüme, noter masrafları, harçlar) göre projelendirilerek belirlenir. Şeffaflık ilkemiz gereği, çalışmaya başlamadan önce tüm maliyetleri tarafınıza bildiriyoruz."
  },
  {
    q: "Sadece İstanbul'da mı hizmet veriyorsunuz?",
    a: "Merkezimiz İstanbul'da olmakla birlikte, Türkiye'nin farklı şehirlerindeki (Ankara, İzmir, Antalya vb.) operasyonları da yönetebiliyoruz. Aynı zamanda Tahran ofisimizle Türkiye - İran ekseninde iki ülkede de entegre bir hizmet sağlıyoruz."
  }
];
---
<BaseLayout title="Sıkça Sorulan Sorular | Mina Beigi" description="Mina Beigi Uluslararası Danışmanlık hizmetleri hakkında sıkça sorulan sorular (SSS). İranlı yatırımcılar, çalışma izni, vatandaşlık, deport ve şirket kuruluşu detayları." lang="tr">
  <Fragment slot="head">
    <link rel="canonical" href={SITE_URL + "/tr/sss/"} />
    <link rel="alternate" hreflang="tr" href={SITE_URL + "/tr/sss/"} />
    <link rel="alternate" hreflang="fa" href={SITE_URL + "/fa/faq/"} />
    <link rel="alternate" hreflang="x-default" href={SITE_URL + "/tr/sss/"} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    })} />
  </Fragment>

  <div class="relative py-20 md:py-24 bg-primary border-b border-primary overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-40 z-0" style="background-image: url('/images/hero-office.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/80 to-primary/30 z-10"></div>
    <div class="container mx-auto px-4 max-w-4xl text-center relative z-20">
      <h1 class="text-4xl md:text-5xl font-bold text-ivory mb-6">Sıkça Sorulan Sorular</h1>
      <p class="text-ivory/80 text-lg max-w-2xl mx-auto">Süreçlerimiz, hizmet detaylarımız ve çalışma prensiplerimiz hakkında aklınıza takılan soruların yanıtları.</p>
    </div>
  </div>

  <div class="py-16 md:py-20 bg-primary min-h-[50vh]">
    <div class="container mx-auto px-4 max-w-3xl">
      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="group bg-surface rounded-xl border border-primary/50 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-5 text-ivory font-semibold">
              <h2 class="text-lg">{faq.q}</h2>
              <span class="relative size-5 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 size-5 opacity-100 group-open:opacity-0 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 size-5 opacity-0 group-open:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-5 pt-0 text-ivory/75 leading-relaxed">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
      
      <div class="mt-12 bg-surface/80 border border-brand/20 p-8 rounded-2xl text-center">
        <h3 class="text-xl font-bold text-ivory mb-3">Aradığınız cevabı bulamadınız mı?</h3>
        <p class="text-ivory/70 mb-6">Size özel durumunuzla ilgili detaylı bilgi almak için bizimle iletişime geçebilirsiniz.</p>
        <a href="/tr/iletisim/" class="inline-flex justify-center items-center bg-brand text-primary font-semibold px-8 py-3 rounded-lg hover:bg-ivory transition-colors">
          İletişime Geçin
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
