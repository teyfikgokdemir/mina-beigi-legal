---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Öğrenci İkamet Süreçleri" description="Öğrenci İkamet Süreçleri - Mina Beigi" lang="tr">
  <div class="py-24 bg-surface border-b border-primary">
    <div class="container mx-auto px-4 max-w-4xl text-center">
      <h1 class="text-4xl font-bold text-ivory mb-6">Öğrenci İkamet Süreçleri</h1>
      <div class="w-24 h-1 bg-brand mx-auto rounded-full"></div>
    </div>
  </div>
  <div class="py-20 bg-primary min-h-[50vh]">
    <div class="container mx-auto px-4 max-w-3xl text-ivory/80 leading-relaxed text-lg" dir="ltr">
      <p>Yabancı uyruklu öğrenciler için ikamet izni başvuruları ve dosya hazırlık koordinasyonu.</p>
    </div>
  </div>
</BaseLayout>
