---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../consts';

const services = [
  { link: '/tr/calisma-izni/', title: 'Çalışma İzni Süreçleri', desc: 'Türkiye\'de yabancı personeller ve şirket ortakları için çalışma izni başvurusu, yenileme ve takip süreçlerinin uçtan uca yönetimi.' },
  { link: '/tr/ogrenci-ikameti/', title: 'Öğrenci İkameti', desc: 'Türkiye\'deki üniversitelerde eğitim gören uluslararası öğrenciler için ikamet izni (öğrenci vizesi) başvuru koordinasyonu.' },
  { link: '/tr/gayrimenkul-ikamet-vatandaslik/', title: 'İkamet ve Vatandaşlık', desc: 'Gayrimenkul yatırımı yoluyla Türkiye\'de ikamet izni ve Türk vatandaşlığı başvuru süreçlerinin eksiksiz yönetimi.' },
  { link: '/tr/sirket-kurulusu/', title: 'Şirket Kuruluşu', desc: 'Yabancı yatırımcılar için Türkiye\'de limited (LTD) veya anonim (A.Ş.) şirket kurulumu, ticaret odası kayıtları ve yasal süreç danışmanlığı.' },
  { link: '/tr/yatirim-danismanligi/', title: 'Yatırım Danışmanlığı', desc: 'Türkiye pazarında doğru yatırım alanlarının belirlenmesi, risk analizi ve yerel uzmanlara yönlendirme desteği.' },
  { link: '/tr/deport-ret-surecleri/', title: 'Deport / Ret Süreçleri', desc: 'İkamet izni ret kararları ve deport (sınır dışı) dosyalarının ön incelemesi ve hukuki uzmanlara yönlendirme hizmeti.' },
  { link: '/tr/tercumanlik/', title: 'Resmî Tercümanlık', desc: 'Noter onaylı ve resmî kurumlarda geçerli her türlü belgenin Türkçe-Farsça yeminli tercüme ve tasdik işlemleri.' }
];
---
<BaseLayout title="Hizmetlerimiz | Mina Beigi" description="Türkiye’de Göçmenlik, Yatırım, Şirket Kuruluşu ve Resmî Süreç Danışmanlığı" lang="tr">
  <Fragment slot="head">
    <link rel="canonical" href={SITE_URL + "/tr/hizmetler"} />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "Mina Beigi Uluslararası Danışmanlık",
        "description": "Türkiye'de göçmenlik, yatırım ve şirket kuruluşu süreçlerinde profesyonel danışmanlık hizmetleri.",
        "url": "{SITE_URL}/tr/hizmetler"
      }
    </script>
  </Fragment>

  <div class="relative py-32 bg-primary border-b border-primary overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center object-cover opacity-80 z-0" style="background-image: url('/images/hero-company.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/30 to-transparent z-10"></div>
    <div class="container mx-auto px-4 max-w-4xl text-center relative z-20">
      <nav class="text-sm text-bronze/80 mb-6 flex items-center justify-center gap-2" aria-label="Breadcrumb" dir="ltr">
        <a href="/tr/" class="hover:text-brand transition-colors">Ana Sayfa</a>
        <span>/</span>
        <span class="text-ivory/60">Hizmetler</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold text-ivory mb-6 leading-tight">Türkiye’de Göçmenlik, Yatırım ve <span class="text-brand">Resmî Süreç</span> Danışmanlığı</h1>
      <p class="text-lg text-ivory/80 max-w-2xl mx-auto leading-relaxed">
        Türkiye ile İran arasındaki ticari, hukuki ve resmî işlerinizde profesyonel çözüm ortağınız. Tüm hizmetlerimizi aşağıdan inceleyebilirsiniz.
      </p>
    </div>
  </div>

  <div class="py-24 bg-primary">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map(s => (
          <div class="bg-surface border border-primary rounded-xl p-8 hover:-translate-y-2 hover:border-brand transition-all duration-300 shadow-lg flex flex-col">
            <h3 class="text-2xl font-bold text-ivory mb-4">{s.title}</h3>
            <p class="text-ivory/70 leading-relaxed mb-8 flex-grow">{s.desc}</p>
            <a href={s.link} class="inline-flex items-center gap-2 text-brand font-semibold hover:text-bronze transition-colors mt-auto">
              Detayları İncele <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
