---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { SITE_URL } from '../../consts';
---
<BaseLayout title="ترجمه رسمی فارسی و ترکی | Mina Beigi" description="ترجمه رسمی اسناد فارسی–ترکی و ترجمه شفاهی در امور اداری و رسمی." lang="fa">
  <Fragment slot="head">
    <link rel="canonical" href={SITE_URL + "/fa/translation/"} />
    <link rel="alternate" hreflang="tr" href={SITE_URL + "/tr/tercumanlik/"} />
    <link rel="alternate" hreflang="fa" href={SITE_URL + "/fa/translation/"} />
    <link rel="alternate" hreflang="x-default" href={SITE_URL + "/tr/tercumanlik/"} />
  </Fragment>

  <div class="relative py-20 md:py-24 bg-primary border-b border-primary overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-75 z-0" style="background-image: url('/images/hero-translation.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/35 to-primary/10 z-10"></div>
    <div class="container mx-auto px-4 max-w-4xl text-center relative z-20" dir="rtl">
      <nav class="text-sm text-bronze/80 mb-5 flex items-center justify-center gap-2" aria-label="Breadcrumb">
        <a href="/fa/" class="hover:text-brand">خانه</a><span>/</span>
        <a href="/fa/services/" class="hover:text-brand">خدمات</a><span>/</span>
        <span class="text-ivory/60" aria-current="page">ترجمه رسمی فارسی و ترکی</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold text-ivory mb-5">ترجمه رسمی فارسی و ترکی</h1>
      <p class="text-ivory/75 max-w-2xl mx-auto">ترجمه رسمی اسناد فارسی–ترکی و ترجمه شفاهی در امور اداری و رسمی.</p>
    </div>
  </div>

  <main class="py-12 md:py-16 bg-primary">
    <div class="container mx-auto px-4 max-w-5xl text-ivory/80 leading-relaxed text-lg space-y-10" dir="rtl">
      
<section><h2 class="text-3xl font-bold text-ivory mb-4">ترجمه رسمی فارسی–ترکی</h2><p>برای نوتر، اداره ثبت، شرکت، قرارداد، وکالت‌نامه، مدرک تحصیلی و سایر امور رسمی، ترجمه باید با هدف استفاده از سند و اصطلاحات درست هماهنگ باشد.</p></section>
<section><h2 class="text-2xl font-bold text-ivory mb-4">دامنه خدمات</h2><div class="grid sm:grid-cols-2 gap-4"><div class="bg-surface p-5 rounded-xl"><strong class="text-ivory block mb-2">ترجمه کتبی</strong><span class="text-sm">پاسپورت، مدرک تحصیلی، قرارداد، وکالت‌نامه و اسناد شرکتی.</span></div><div class="bg-surface p-5 rounded-xl"><strong class="text-ivory block mb-2">ترجمه شفاهی</strong><span class="text-sm">همراهی در نوتر، تاپو و سایر امور رسمی.</span></div></div></section>
<section><h2 class="text-2xl font-bold text-ivory mb-4">مراحل</h2><ol class="space-y-3 text-ivory/70"><li><strong class="text-ivory">۱.</strong> مرجع استفاده از سند و هدف ترجمه مشخص می‌شود.</li><li><strong class="text-ivory">۲.</strong> نیاز به تایید نوتر یا سایر تاییدها بررسی می‌شود.</li><li><strong class="text-ivory">۳.</strong> فرمت تحویل و زمان‌بندی هماهنگ می‌شود.</li></ol></section>
<section><h2 class="text-2xl font-bold text-ivory mb-4">سوالات متداول</h2><div class="space-y-3"><details class="bg-surface p-5 rounded-xl"><summary class="font-semibold text-ivory cursor-pointer">آیا همه ترجمه‌ها باید نوتر شوند؟</summary><p class="mt-3 text-sm">خیر. نیاز به تایید بستگی به مرجع و نوع استفاده از سند دارد.</p></details><details class="bg-surface p-5 rounded-xl"><summary class="font-semibold text-ivory cursor-pointer">مدارک فارسی ترجمه می‌شوند؟</summary><p class="mt-3 text-sm">بله، ترجمه رسمی فارسی–ترکی در حوزه خدمات قرار دارد.</p></details><details class="bg-surface p-5 rounded-xl"><summary class="font-semibold text-ivory cursor-pointer">همراهی در نوتر یا تاپو انجام می‌شود؟</summary><p class="mt-3 text-sm">بسته به نوع معامله، ترجمه شفاهی و حضوری قابل برنامه‌ریزی است.</p></details></div></section>

      <section class="pt-8 border-t border-surface">
        <div class="bg-surface p-6 md:p-10 rounded-2xl border border-primary shadow-xl">
          <h2 class="text-3xl font-bold text-ivory mb-4 text-center">پرونده شما را بررسی کنیم</h2>
          <p class="text-center text-ivory/70 mb-8">وضعیت خود را کوتاه توضیح دهید تا برای مدارک، مراحل و مسیر قابل پیگیری ارزیابی اولیه انجام شود.</p>
          <ContactForm lang="fa" />
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
