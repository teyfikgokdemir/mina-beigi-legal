---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { SITE_URL } from '../../consts';

const faq = [
  { q: 'برای جلسه اول چه اطلاعاتی لازم است؟', a: 'نوع درخواست، وضعیت فعلی، هدف شما و در صورت وجود مدارک یا تصمیم‌های قبلی برای ارزیابی اولیه کافی است.' },
  { q: 'آیا می‌توانم به فارسی ارتباط بگیرم؟', a: 'بله. ارتباط به زبان فارسی و ترکی امکان‌پذیر است.' },
  { q: 'می‌توانم مدارک را از طریق واتساپ ارسال کنم؟', a: 'برای ارزیابی اولیه می‌توانید اطلاعات و مدارک پایه را ارسال کنید. برای مدارک حساس در صورت نیاز روش مناسب‌تری پیشنهاد می‌شود.' },
  { q: 'چه زمانی پاسخ دریافت می‌کنم؟', a: 'زمان پاسخ به حجم درخواست‌ها بستگی دارد و تلاش می‌شود در کوتاه‌ترین زمان ممکن پاسخ داده شود؛ زمان قطعی تضمین نمی‌شود.' }
];
---
<BaseLayout title="تماس با ما | Mina Beigi" description="اطلاعات تماس استانبول و تهران، واتساپ ترکیه و ایران و فرم درخواست مشاوره برای سرمایه‌گذاری، اقامت، شرکت و ترجمه رسمی." lang="fa">
  <Fragment slot="head">
    <link rel="canonical" href={SITE_URL + "/fa/contact/"} />
    <link rel="alternate" hreflang="tr" href={SITE_URL + "/tr/iletisim/"} />
    <link rel="alternate" hreflang="fa" href={SITE_URL + "/fa/contact/"} />
    <link rel="alternate" hreflang="x-default" href={SITE_URL + "/tr/iletisim/"} />
  </Fragment>

  <section class="relative py-12 md:py-10 bg-surface border-b border-primary overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/tehran-bg.webp')] bg-cover bg-center opacity-25"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/65 to-primary/45"></div>
    <div class="container mx-auto px-4 max-w-5xl text-center relative z-10" dir="rtl">
      <p class="text-brand text-sm font-semibold mb-2">استانبول • تهران</p>
      <h1 class="text-3xl md:text-4xl font-bold text-ivory mb-3">تماس با ما</h1>
      <p class="text-base md:text-lg text-ivory/75 max-w-3xl mx-auto">برای امور مهاجرتی، سرمایه‌گذاری، ثبت شرکت، ملک، ترجمه رسمی و سایر فرآیندهای اداری در ترکیه، وضعیت خود را توضیح دهید تا ارزیابی اولیه انجام شود.</p>
    </div>
  </section>

  <section class="py-8 md:py-10 bg-primary">
    <div class="container mx-auto px-4 max-w-6xl" dir="rtl">
      <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-6 lg:gap-8 items-start">
        <div class="space-y-3">
          <div class="grid sm:grid-cols-2 lg:grid-cols-1 gap-4">
            <div class="bg-surface rounded-xl border border-primary p-4 md:p-5">
              <span class="text-brand text-sm font-semibold">ترکیه</span>
              <h2 class="text-xl font-bold text-ivory mt-1 mb-1">استانبول / پندیک</h2>
              <a href="tel:+905392425624" class="block text-ivory/80 hover:text-brand transition-colors" dir="ltr">+90 539 2425 624</a>
              <a href="https://wa.me/905392425624" target="_blank" class="inline-flex mt-2 text-[#25D366] font-semibold">واتساپ ترکیه ←</a>
            </div>
            <div class="bg-surface rounded-xl border border-primary p-4 md:p-5">
              <span class="text-brand text-sm font-semibold">ایران</span>
              <h2 class="text-xl font-bold text-ivory mt-1 mb-1">تهران</h2>
              <a href="tel:+989125102088" class="block text-ivory/80 hover:text-brand transition-colors" dir="ltr">+98 912 510 20 88</a>
              <a href="https://wa.me/989125102088" target="_blank" class="inline-flex mt-2 text-[#25D366] font-semibold">واتساپ ایران ←</a>
            </div>
          </div>

          <div class="bg-surface rounded-xl border border-primary p-4 md:p-5">
            <h2 class="text-lg font-bold text-ivory mb-2">برای چه موضوعاتی می‌توانید تماس بگیرید؟</h2>
            <ul class="space-y-2 text-ivory/70 text-sm">
              <li>• اجازه کار و اقامت تحصیلی</li>
              <li>• ثبت شرکت و سرمایه‌گذاری</li>
              <li>• ملک، اقامت و شهروندی</li>
              <li>• بررسی اولیه پرونده‌های دیپورت و ریجکت</li>
              <li>• ترجمه رسمی فارسی–ترکی</li>
              <li>• حساب بانکی، شماره مالیاتی و امور مالی</li>
            </ul>
          </div>

          <div class="bg-surface rounded-xl border border-primary p-4 md:p-5">
            <h2 class="text-lg font-bold text-ivory mb-2">اینستاگرام</h2>
            <a href="https://www.instagram.com/mina_beigi_lawyer" target="_blank" class="inline-flex items-center gap-3 text-bronze hover:text-brand transition-colors" dir="ltr">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              @mina_beigi_lawyer
            </a>
          </div>
        </div>
        <div class="lg:pt-0">
          <ContactForm lang="fa" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 bg-surface border-t border-primary">
    <div class="container mx-auto px-4 max-w-5xl" dir="rtl">
      <h2 class="text-2xl font-bold text-ivory text-center mb-5">سوالات متداول درباره تماس</h2>
      <div class="grid md:grid-cols-2 gap-4">
        {faq.map(item => (
          <details class="bg-primary border border-surface rounded-xl p-4">
            <summary class="font-semibold text-ivory cursor-pointer">{item.q}</summary>
            <p class="mt-3 text-sm text-ivory/70">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
