---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = "راهنمای زندگی، سرمایه‌گذاری و امور رسمی در ترکیه";
const description = "راهنماهای کاربردی برای ایرانیان درباره اجازه کار، اقامت، ثبت شرکت، سرمایه‌گذاری، ملک، بانک و امور رسمی در ترکیه.";
---

<BaseLayout title={title} description={description} lang="fa">
  <section class="relative py-20 bg-primary overflow-hidden">
    <div class="container mx-auto px-4 relative z-20 text-center max-w-4xl">
      <h1 class="text-3xl md:text-5xl font-bold mb-6 text-ivory leading-tight tracking-tight">
        {title}
      </h1>
      <p class="text-lg text-ivory/70 mb-0 mx-auto font-light leading-relaxed">
        {description}
      </p>
    </div>
  </section>

  <section class="py-16 bg-surface border-y border-primary">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- Blog 1 -->
        <a href="/fa/blog/2026-turkey-work-permit-rules/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <div class="w-full h-full bg-gradient-to-tr from-primary to-surface flex items-center justify-center text-ivory/20 group-hover:scale-105 transition-transform duration-500">
               <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5L18.5 7H20z"></path></svg>
             </div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">اجازه کار</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">تغییرات معیارهای اجازه کار ترکیه در سال ۲۰۲۶</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">قوانین جدید ارزیابی، استثنائات و سناریوهای عملی برای شهروندان ایرانی از تاریخ ۳ آگوست ۲۰۲۶.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>آخرین به‌روزرسانی: سپتامبر ۲۰۲۶</span>
              <span class="text-brand font-medium">ادامه مطلب &larr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 2 -->
        <a href="/fa/blog/2026-turkey-work-permit-exemption/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <div class="w-full h-full bg-gradient-to-tr from-primary to-surface flex items-center justify-center text-ivory/20 group-hover:scale-105 transition-transform duration-500">
               <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
             </div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">معافیت</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">معافیت از اجازه کار در ترکیه ۲۰۲۶: سیستم جدید</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">تغییرات سیستم در تاریخ ۱۷ سپتامبر ۲۰۲۶، تفاوت اجازه کار با معافیت از اجازه کار و افرادی که شامل این معافیت می‌شوند.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>آخرین به‌روزرسانی: سپتامبر ۲۰۲۶</span>
              <span class="text-brand font-medium">ادامه مطلب &larr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 3 -->
        <a href="/fa/blog/iranian-company-formation-residence-work-permit/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <div class="w-full h-full bg-gradient-to-tr from-primary to-surface flex items-center justify-center text-ivory/20 group-hover:scale-105 transition-transform duration-500">
               <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
             </div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">ثبت شرکت</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">آیا ثبت شرکت در ترکیه برای ایرانیان اقامت یا اجازه کار می‌دهد؟</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">مزایای واقعی ثبت شرکت، ساختار سرمایه، معیارهای فعلی و اشتباهات رایج سرمایه‌گذاران ایرانی.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>آخرین به‌روزرسانی: سپتامبر ۲۰۲۶</span>
              <span class="text-brand font-medium">ادامه مطلب &larr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 4 -->
        <a href="/fa/blog/opening-bank-account-in-turkey-for-iranians/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <div class="w-full h-full bg-gradient-to-tr from-primary to-surface flex items-center justify-center text-ivory/20 group-hover:scale-105 transition-transform duration-500">
               <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
             </div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">امور بانکی</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">افتتاح حساب بانکی در ترکیه برای ایرانیان ۲۰۲۶</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">حساب‌های شخصی و شرکتی، شماره مالیاتی، الزامات KYC، انتقال پول و کنترل‌های بین‌المللی/تحریم‌ها.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>آخرین به‌روزرسانی: سپتامبر ۲۰۲۶</span>
              <span class="text-brand font-medium">ادامه مطلب &larr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 5 -->
        <a href="/fa/blog/turkish-citizenship-by-investment-2026/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <div class="w-full h-full bg-gradient-to-tr from-primary to-surface flex items-center justify-center text-ivory/20 group-hover:scale-105 transition-transform duration-500">
               <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
             </div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">شهروندی</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">اخذ شهروندی ترکیه با خرید ملک در سال ۲۰۲۶</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">شرط ۴۰۰ هزار دلار، سند مالکیت و قانون عدم فروش ۳ ساله، ارزیابی املاک و اشتباهات رایج سرمایه‌گذاران.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>آخرین به‌روزرسانی: سپتامبر ۲۰۲۶</span>
              <span class="text-brand font-medium">ادامه مطلب &larr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 6 -->
        <a href="/fa/blog/turkey-residence-permit-2026/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <div class="w-full h-full bg-gradient-to-tr from-primary to-surface flex items-center justify-center text-ivory/20 group-hover:scale-105 transition-transform duration-500">
               <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"></path></svg>
             </div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">اقامت</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">اقامت ترکیه ۲۰۲۶ برای ایرانیان: راهنمای سیستم و درخواست</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">سیستم اقامت الکترونیکی (e-ikamet)، اقامت از طریق خرید ملک و ارتباط کاری، تمکن مالی، زمان‌بندی درخواست و راهنمای ایرانیان.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>آخرین به‌روزرسانی: سپتامبر ۲۰۲۶</span>
              <span class="text-brand font-medium">ادامه مطلب &larr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 7 -->
        <a href="/fa/blog/student-residence-and-work-rights/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <div class="w-full h-full bg-gradient-to-tr from-primary to-surface flex items-center justify-center text-ivory/20 group-hover:scale-105 transition-transform duration-500">
               <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"></path></svg>
             </div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">تحصیل و اقامت</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">اقامت دانشجویی و اجازه کار در ترکیه برای ایرانیان ۲۰۲۶</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">شرایط درخواست اقامت برای دانشجویان خارجی، تغییر دانشگاه، حقوق کار و تغییر وضعیت پس از فارغ‌التحصیلی.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>آخرین به‌روزرسانی: سپتامبر ۲۰۲۶</span>
              <span class="text-brand font-medium">ادامه مطلب &larr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 8 -->
        <a href="/fa/blog/deportation-entry-ban-residence-rejection/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <div class="w-full h-full bg-gradient-to-tr from-primary to-surface flex items-center justify-center text-ivory/20 group-hover:scale-105 transition-transform duration-500">
               <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
             </div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">امور حقوقی</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">دیپورت، ممنوعیت ورود و ریجکت اقامت ترکیه</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">کدهای محدودیت، تصمیمات دیپورت، زمان ابلاغ در موارد ریجکت اقامت و روندهای نمایندگی حقوقی.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>آخرین به‌روزرسانی: سپتامبر ۲۰۲۶</span>
              <span class="text-brand font-medium">ادامه مطلب &larr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 9 -->
        <a href="/fa/blog/setting-up-factory-in-turkey/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <div class="w-full h-full bg-gradient-to-tr from-primary to-surface flex items-center justify-center text-ivory/20 group-hover:scale-105 transition-transform duration-500">
               <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
             </div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">سرمایه‌گذاری و تولید</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">راه‌اندازی کارخانه و کارگاه تولیدی در استانبول و ترکیه برای سرمایه‌گذاران ایرانی</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">مناطق صنعتی (OSB)، مجوزهای تولید، معافیت‌های اجازه کار و روندهای راه‌اندازی کارخانه.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>آخرین به‌روزرسانی: سپتامبر ۲۰۲۶</span>
              <span class="text-brand font-medium">ادامه مطلب &larr;</span>
            </div>
          </div>
        </a>

        <!-- Blog 10 -->
        <a href="/fa/blog/business-setup-guide-for-iranians-2026-2027/" class="group flex flex-col bg-primary rounded-xl border border-primary hover:border-brand hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <div class="aspect-video bg-surface overflow-hidden">
             <div class="w-full h-full bg-gradient-to-tr from-primary to-surface flex items-center justify-center text-ivory/20 group-hover:scale-105 transition-transform duration-500">
               <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
             </div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs text-brand uppercase tracking-wider mb-2 font-semibold">راهنما</span>
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-rose transition-colors">راهنمای سرمایه‌گذاری و راه‌اندازی کسب‌وکار در ترکیه برای ایرانیان ۲۰۲۶–۲۰۲۷</h3>
            <p class="text-ivory/60 text-sm mb-4 line-clamp-3">انواع شرکت، مرسیس، E-TUYS، ثبت تجاری، بانک، مالیات، مجوزها و چک‌لیست قبل از عملیات.</p>
            <div class="mt-auto pt-4 border-t border-surface flex justify-between items-center text-xs text-ivory/50">
              <span>آخرین به‌روزرسانی: سپتامبر ۲۰۲۶</span>
              <span class="text-brand font-medium">ادامه مطلب &larr;</span>
            </div>
          </div>
        </a>

      </div>
    </div>
  </section>
</BaseLayout>
