---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
---
<BaseLayout title="خانه | Mina Beigi" description="سرمایه‌گذاری و راه‌اندازی کسب‌وکار در ترکیه با همراهی حرفه‌ای" lang="fa">
  <section class="relative min-h-[90vh] flex items-center bg-primary overflow-hidden border-b border-surface">
    <div class="absolute inset-0 bg-[url('/images/hero-office.webp')] bg-cover bg-center opacity-10"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-primary/60 via-primary/80 to-primary"></div>
    
    <div class="container mx-auto px-4 relative z-10 text-center flex flex-col items-center justify-center pt-20">
      <span class="inline-block py-1 px-3 border border-surface bg-surface/50 rounded-full text-bronze text-sm tracking-widest uppercase mb-8 backdrop-blur">
        مشاوره بین‌المللی
      </span>
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold mb-8 text-ivory leading-tight tracking-tight" dir="rtl">
        سرمایه‌گذاری و راه‌اندازی کسب‌وکار در ترکیه با <span class="text-brand">همراهی حرفه‌ای</span>
      </h1>
      <p class="text-lg md:text-xl text-ivory/70 mb-12 max-w-3xl mx-auto font-light leading-relaxed" dir="rtl">
        از ثبت شرکت و خرید ملک تا امور اقامت، مجوزها و هماهنگی‌های رسمی؛ همراهی حرفه‌ای برای سرمایه‌گذاران ایرانی در ترکیه.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-5" dir="rtl">
        <a href="#contact" class="bg-brand text-white font-semibold py-4 px-10 rounded shadow-2xl hover:bg-[#A33850] hover:-translate-y-1 transition-all duration-300">
          درخواست مشاوره سرمایه‌گذاری
        </a>
        <a href="https://wa.me/989125102088" target="_blank" class="bg-surface border border-primary text-ivory font-semibold py-4 px-10 rounded hover:bg-primary transition-all duration-300">
          مشاوره از طریق واتساپ
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-surface border-y border-primary">
    <div class="container mx-auto px-4 max-w-4xl text-center" dir="rtl">
      <h2 class="text-2xl md:text-3xl font-light text-ivory leading-relaxed">
        ارائه خدمات یکپارچه مشاوره‌ای، تجاری و هماهنگی امور رسمی برای <span class="text-bronze font-semibold">سرمایه‌گذاران و کارآفرینان ایرانی</span> با بالاترین استانداردها.
      </h2>
    </div>
  </section>

  <section class="py-24 bg-primary">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row justify-between items-end mb-16" dir="rtl">
        <div class="max-w-2xl text-start">
          <h2 class="text-4xl font-bold text-ivory mb-4">خدمات تخصصی ما</h2>
          <p class="text-ivory/60 text-lg">مدیریت صفر تا صد امور سرمایه‌گذاری، اقامتی و هماهنگی‌های رسمی در ترکیه.</p>
        </div>
        <a href="/fa/services" class="text-bronze hover:text-brand font-medium mt-6 md:mt-0 flex items-center gap-2 transition-colors">
          مشاهده تمام خدمات <span aria-hidden="true" class="rotate-180 inline-block">&larr;</span>
        </a>
      </div>
      
      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6" dir="rtl">
        {[
          {l: '/fa/investment-consulting', t: 'سرمایه گذاری در ترکیه', d: 'مشاوره سرمایه گذاری در استانبول، تحلیل بازار و راهنمایی سرمایه‌گذاران خارجی.'},
          {l: '/fa/company-formation', t: 'ثبت شرکت در ترکیه برای ایرانیان', d: 'راه اندازی کسب و کار در ترکیه، دریافت مجوزهای تجاری و هماهنگی‌های ثبت شرکت.'},
          {l: '/fa/property-residence-citizenship', t: 'خرید ملک در ترکیه / اقامت / شهروندی', d: 'اقامت ترکیه از طریق سرمایه گذاری، بررسی اسناد ملکی و هماهنگی امور شهروندی.'},
          {l: '/fa/work-permit', t: 'مجوزهای تجاری و رسمی', d: 'دریافت مجوز کار و اقامت تجاری برای مدیران و هماهنگی‌های رسمی.'},
          {l: '/fa/student-residence', t: 'اقامت ترکیه و مجوز کار', d: 'اخذ اقامت تحصیلی و کاری، و هماهنگی فرآیندهای اقامتی در ترکیه.'},
          {l: '/fa/translation', t: 'ترجمه رسمی', d: 'ترجمه رسمی مدارک با تایید نوتر برای تمامی امور ثبتی و قانونی.'},
          {l: '/fa/deport-rejection', t: 'بررسی اولیه پرونده‌های دیپورت و ریجکت', d: 'بررسی اولیه پرونده و هماهنگی برای ارجاع به متخصصان ذیصلاح در صورت نیاز.'}
        ].map(s => (
          <a href={s.l} class="group block p-8 bg-surface rounded-xl border border-primary hover:-translate-y-1 hover:border-brand hover:shadow-2xl hover:shadow-brand/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand transition-all duration-300 text-start">
            <h3 class="text-xl font-bold text-ivory mb-3 group-hover:text-brand transition-colors">{s.t} <span class='inline-block transition-transform group-hover:-translate-x-1'>&larr;</span></h3>
            <p class="text-ivory/60 leading-relaxed text-sm">{s.d}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-surface border-y border-primary">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="flex flex-col lg:flex-row-reverse items-center gap-16" dir="rtl">
        <div class="w-full lg:w-5/12 relative">
          <div class="absolute -inset-4 bg-brand/10 rounded-3xl transform -rotate-3"></div>
          <div class="relative aspect-[4/5] rounded-2xl overflow-hidden bg-primary border border-surface">
            <img src="/images/mina-profile.webp" alt="مینا بیگی" class="w-full h-full object-cover grayscale-[20%]" onerror="this.style.display='none'" />
            <div class="absolute inset-0 flex items-center justify-center text-ivory/30 text-sm" style="z-index:-1;">عکس پروفایل</div>
          </div>
        </div>
        <div class="w-full lg:w-7/12 text-start">
          <span class="text-rose font-medium tracking-wide uppercase text-sm mb-3 block">چرا ما را انتخاب کنید؟</span>
          <h2 class="text-4xl font-bold mb-6 text-ivory">درباره مینا بیگی</h2>
          <p class="text-lg text-ivory/80 mb-8 leading-relaxed">
            با تمرکز بر نیازهای کارآفرینان و سرمایه‌گذاران ایرانی، بستری مطمئن برای مدیریت امور تجاری و اقامتی شما در ترکیه فراهم کرده‌ایم.
          </p>
          <div class="bg-primary p-6 rounded-xl border border-surface mb-8">
            <ul class="space-y-4 text-ivory/90 font-medium">
              <li class="flex items-center gap-4"><div class="w-2 h-2 rounded-full bg-brand"></div> <span>ارتباط مستقیم به زبان فارسی</span></li>
              <li class="flex items-center gap-4"><div class="w-2 h-2 rounded-full bg-accent"></div> <span>حضور فعال در تهران و استانبول</span></li>
              <li class="flex items-center gap-4"><div class="w-2 h-2 rounded-full bg-rose"></div> <span>آشنایی با فرآیندهای تجاری، اداری و فرهنگی ایران و ترکیه</span></li>
              <li class="flex items-center gap-4"><div class="w-2 h-2 rounded-full bg-bronze"></div> <span>مدیریت یکپارچه سرمایه‌گذاری، ثبت شرکت، اقامت و امور رسمی</span></li>
              <li class="flex items-center gap-4"><div class="w-2 h-2 rounded-full bg-white"></div> <span>ارجاع به متخصصین و مشاورین مالی مجاز در ترکیه در صورت نیاز</span></li>
            </ul>
          </div>
          <p class="text-sm text-ivory/50 bg-primary/30 p-4 rounded-lg border border-primary">
            مینا بیگی وکیل دارای مجوز در ایران است و در ترکیه پشتیبانی حرفه‌ای در زمینه‌های ترجمه رسمی، مشاوره فرآیندهای مهاجرتی، هماهنگی درخواست‌ها و سرمایه‌گذاری ارائه می‌دهد.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="py-24 bg-primary relative overflow-hidden">
    <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-brand/5 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
    
    <div class="container mx-auto px-4 relative z-10 text-center" dir="rtl">
      <div class="max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl font-bold text-ivory mb-6">درخواست ارزیابی پرونده</h2>
        <p class="text-ivory/70 text-lg">برای شروع فرآیند سرمایه‌گذاری و یا هماهنگی امور رسمی در ترکیه، فرم زیر را پر کنید تا با شما تماس بگیریم.</p>
      </div>
      <ContactForm lang="fa" />
    </div>
  </section>
</BaseLayout>
