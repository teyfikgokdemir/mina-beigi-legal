---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_URL } from "../../consts";

const faqs = [
  {
    q: "شرکت مشاوره بین‌المللی مینا بیگی در چه زمینه‌هایی فعالیت می‌کند؟",
    a: "ما در زمینه‌های ثبت شرکت در ترکیه، فرآیندهای اجازه کار و اقامت، مشاوره سرمایه‌گذاری، افتتاح حساب بانکی بین‌المللی، فرآیندهای املاک و شهروندی، و خدمات ترجمه رسمی فعالیت می‌کنیم."
  },
  {
    q: "آیا برای سرمایه‌گذاران ایرانی مشاوره مالی و بانکی ویژه‌ای ارائه می‌دهید؟",
    a: "بله. ما به طور خاص برای شهروندان ایرانی که با مسائلی مانند افتتاح حساب بانکی در ترکیه، انتقال سرمایه شرکت و انتقال بین‌المللی پول (فرآیندهای انطباق/Compliance) مواجه هستند، خدمات مشاوره حقوقی ارائه می‌دهیم تا این فرآیندها بدون مشکل پیش بروند."
  },
  {
    q: "آیا شهروندان ایرانی با ثبت شرکت در ترکیه به طور خودکار اجازه کار دریافت می‌کنند؟",
    a: "خیر، ثبت شرکت و دریافت اجازه کار دو فرآیند حقوقی کاملاً متفاوت هستند. شریک یا مدیر شرکت بودن به طور خودکار حق کار ایجاد نمی‌کند. برای دریافت اجازه کار، کسب‌وکار باید معیارهای قانونی مشخصی مانند سرمایه، گردش مالی و استخدام شهروندان ترک را داشته باشد. کارشناسان ما این برنامه‌ریزی را از ابتدا برای شما انجام می‌دهند."
  },
  {
    q: "آیا در موارد دیپورت (اخراج) یا رد درخواست اقامت پشتیبانی حقوقی ارائه می‌دهید؟",
    a: "بله. در موارد رد درخواست اجازه اقامت، ممنوعیت ورود به ترکیه (کدهای محدودیت - مانند G-87، Ç-114، V-84 و غیره) و تصمیمات اخراج (دیپورت)، تیم وکلای متخصص ما فرآیندهای اعتراض اداری و اقامه دعوای ابطال در دادگاه‌های اداری ذی‌صلاح را پیگیری می‌کنند."
  },
  {
    q: "فرآیند درخواست شهروندی با خرید ملک در ترکیه چقدر طول می‌کشد؟",
    a: "بر اساس قوانین فعلی، اتباع خارجی که ملکی به ارزش ۴۰۰,۰۰۰ دلار آمریکا خریداری کنند می‌توانند به طور استثنایی برای شهروندی ترکیه درخواست دهند. اخذ گواهی انطباق (Uygunluk Belgesi) قبل از درخواست، اجازه اقامت و مراحل اصلی درخواست شهروندی به طور متوسط بین ۴ تا ۶ ماه زمان می‌برد."
  },
  {
    q: "زمان‌بندی فرآیندها به چه صورت است؟",
    a: "زمان تکمیل فرآیندها بسته به نوع خدمات درخواستی و حجم کاری مراجع رسمی متفاوت است. به عنوان مثال، در حالی که ثبت شرکت می‌تواند طی چند روز انجام شود، فرآیندهای اجازه کار ممکن است هفته‌ها و درخواست شهروندی ماه‌ها طول بکشد. در اولین جلسه، ما یک جدول زمانی دقیق به شما ارائه خواهیم داد."
  },
  {
    q: "هزینه‌های مشاوره شما چگونه تعیین می‌شود؟",
    a: "هزینه‌های ما بر اساس گستره خدمات درخواستی، پیچیدگی فرآیند و مراحل اجرایی مورد نیاز (مانند ترجمه رسمی، هزینه‌های دفترخانه و مالیات‌ها) تعیین و پروژه‌بندی می‌شود. طبق اصل شفافیت، ما تمام هزینه‌ها را پیش از شروع کار به شما اعلام می‌کنیم."
  },
  {
    q: "آیا خدمات شما فقط در استانبول ارائه می‌شود؟",
    a: "اگرچه دفتر مرکزی ما در استانبول واقع شده است، اما ما می‌توانیم عملیات را در شهرهای مختلف ترکیه (مانند آنکارا، ازمیر، آنتالیا و غیره) مدیریت کنیم. علاوه بر این، ما خدمات یکپارچه‌ای را بین ترکیه و ایران از طریق دفتر تهران خود ارائه می‌دهیم."
  }
];
---
<BaseLayout title="سوالات متداول | مینا بیگی" description="پاسخ به سوالات متداول در مورد خدمات مشاوره مینا بیگی. جزئیات سرمایه‌گذاری ایرانیان، اجازه کار، دیپورت، شهروندی و ثبت شرکت." lang="fa" dir="rtl">
  <Fragment slot="head">
    <link rel="canonical" href={SITE_URL + "/fa/faq/"} />
    <link rel="alternate" hreflang="tr" href={SITE_URL + "/tr/sss/"} />
    <link rel="alternate" hreflang="fa" href={SITE_URL + "/fa/faq/"} />
    <link rel="alternate" hreflang="x-default" href={SITE_URL + "/tr/sss/"} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    })} />
  </Fragment>

  <div class="relative py-20 md:py-24 bg-primary border-b border-primary overflow-hidden" dir="rtl">
    <div class="absolute inset-0 bg-cover bg-center opacity-40 z-0" style="background-image: url('/images/hero-office.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/80 to-primary/30 z-10"></div>
    <div class="container mx-auto px-4 max-w-4xl text-center relative z-20">
      <h1 class="text-4xl md:text-5xl font-bold text-ivory mb-6">سوالات متداول</h1>
      <p class="text-ivory/80 text-lg max-w-2xl mx-auto">پاسخ به سوالاتی که در مورد فرآیندها، جزئیات خدمات و اصول کاری ما دارید.</p>
    </div>
  </div>

  <div class="py-16 md:py-20 bg-primary min-h-[50vh]" dir="rtl">
    <div class="container mx-auto px-4 max-w-3xl">
      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="group bg-surface rounded-xl border border-primary/50 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-5 text-ivory font-semibold">
              <h2 class="text-lg">{faq.q}</h2>
              <span class="relative size-5 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 size-5 opacity-100 group-open:opacity-0 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 size-5 opacity-0 group-open:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-5 pt-0 text-ivory/75 leading-relaxed">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
      
      <div class="mt-12 bg-surface/80 border border-brand/20 p-8 rounded-2xl text-center">
        <h3 class="text-xl font-bold text-ivory mb-3">آیا پاسخ مورد نظر خود را پیدا نکردید؟</h3>
        <p class="text-ivory/70 mb-6">برای دریافت اطلاعات دقیق در مورد وضعیت خاص خود می‌توانید با ما تماس بگیرید.</p>
        <a href="/fa/contact/" class="inline-flex justify-center items-center bg-brand text-primary font-semibold px-8 py-3 rounded-lg hover:bg-ivory transition-colors">
          ارتباط با ما
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
