---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../consts';

const faq = [
  {
    q: 'آیا اتباع خارجی می‌توانند در ترکیه شماره مالیاتی دریافت کنند؟',
    a: 'بله. درخواست شماره شناسایی مالیاتی بالقوه برای اتباع خارجی می‌تواند از طریق اداره مالیات دیجیتال سازمان امور مالیاتی انجام شود. اطلاعات هویتی مورد استفاده ممکن است بسته به شماره ملی خارجی فعلی شخص و نوع تراکنش متفاوت باشد.'
  },
  {
    q: 'آیا یک فرد خارجی می‌تواند در ترکیه حساب بانکی باز کند؟',
    a: 'بانک‌ها می‌توانند برای مشتریان خارجی حساب باز کنند؛ اما معیارهای پذیرش از بانکی به بانک دیگر متفاوت است. ممکن است اسناد اضافی در مورد پاسپورت، آدرس، شماره مالیاتی، اطلاعات اقامت و منبع وجوه درخواست شود.'
  },
  {
    q: 'آیا فرآیند حساب شرکتی و حساب شخصی یکسان است؟',
    a: 'خیر. در حساب شرکتی، اسناد شرکتی مانند مدارک ثبت شرکت، اطلاعات مالیاتی، حق امضا و ساختار شراکت به طور جداگانه بررسی می‌شوند.'
  },
  {
    q: 'آیا یک روش استاندارد واحد برای انتقال پول از ایران به ترکیه وجود دارد؟',
    a: 'خیر. سیاست‌های بانکی، طرفین تراکنش، ارز، ماهیت رابطه تجاری و کنترل‌های انطباق می‌توانند بر این روش تأثیر بگذارند. قبل از انجام تراکنش، کانال مورد استفاده و مجموعه اسناد باید مشخص شوند.'
  },
  {
    q: 'آیا افتتاح حساب بانکی تضمین می‌شود؟',
    a: 'خیر. تصمیم نهایی به سیاست‌های پذیرش مشتری و انطباق بانک مربوطه بستگی دارد. در چارچوب مشاوره، می‌توان آماده‌سازی اسناد و هماهنگی فرآیند را پیش از درخواست انجام داد.'
  }
];
---
<BaseLayout title="حساب بانکی، شماره مالیاتی و فرآیندهای مالی | مینا بیگی" description="مشاوره برای دریافت شماره مالیاتی، حساب بانکی، حساب شرکتی، KYC و آماده‌سازی تراکنش‌های مالی در ترکیه برای سرمایه‌گذاران خارجی و ایرانی." lang="fa">
  <Fragment slot="head">
    <link rel="canonical" href={SITE_URL + "/fa/banking-tax-financial-processes/"} />
    <link rel="alternate" hreflang="tr" href={SITE_URL + "/tr/banka-vergi-finansal-surecler/"} />
    <link rel="alternate" hreflang="fa" href={SITE_URL + "/fa/banking-tax-financial-processes/"} />
    <link rel="alternate" hreflang="x-default" href={SITE_URL + "/tr/banka-vergi-finansal-surecler/"} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faq.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    })} />
  </Fragment>

  <div class="relative py-20 md:py-24 bg-primary border-b border-primary overflow-hidden" dir="rtl">
    <div class="absolute inset-0 bg-[url('/images/blog-4.jpg')] bg-cover bg-center opacity-75 z-0"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/35 to-primary/10 z-10"></div>
    <div class="container mx-auto px-4 max-w-4xl text-center relative z-20">
      <nav class="text-sm text-bronze/80 mb-5 flex items-center justify-center gap-2" aria-label="Breadcrumb">
        <a href="/fa/" class="hover:text-brand">صفحه اصلی</a><span>/</span>
        <a href="/fa/services/" class="hover:text-brand">خدمات</a><span>/</span>
        <span class="text-ivory/60">بانک، مالیات و فرآیندهای مالی</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold text-ivory mb-5">حساب بانکی، شماره مالیاتی و فرآیندهای مالی</h1>
      <p class="text-ivory/80 text-lg max-w-3xl mx-auto">آماده‌سازی مدارک مالی، حساب شرکتی، حساب بانکی و شماره مالیاتی برای اتباع خارجی که قصد سرمایه‌گذاری، تأسیس شرکت یا انجام معاملات شخصی در ترکیه را دارند.</p>
    </div>
  </div>

  <main class="py-12 md:py-16 bg-primary" dir="rtl">
    <div class="container mx-auto px-4 max-w-5xl text-ivory/80 leading-relaxed text-lg space-y-10">
      <section>
        <div class="mb-6 rounded-2xl border border-brand/40 bg-surface p-5">
          <h2 class="text-2xl font-bold text-ivory mb-2">افتتاح حساب بانکی بین‌المللی</h2>
          <p class="text-ivory/75">هماهنگی فرآیندهای افتتاح حساب بانکی، KYC، دریافت شماره مالیاتی، منبع وجوه و آماده‌سازی اسناد مالی برای اتباع خارجی و شرکت‌ها.</p>
        </div>
        <h2 class="text-3xl font-bold text-ivory mb-4">یکی از چالش‌برانگیزترین زمینه‌ها برای اتباع خارجی: بانکداری و آماده‌سازی مالی</h2>
        <p class="mb-4">بسیاری از اتباع خارجی که قصد تأسیس شرکت، خرید ملک، پرداخت مالیات یا انجام فعالیت‌های تجاری منظم در ترکیه را دارند، در مراحل اولیه با مسائلی نظیر دریافت شماره مالیاتی، افتتاح حساب بانکی و انتقال پول مواجه می‌شوند. اگرچه این فرآیندها ممکن است مرتبط به نظر برسند، اما هر نهاد ممکن است هویت، آدرس و کنترل‌های انطباق خاص خود را اعمال کند.</p>
        <p>به‌ویژه برای سرمایه‌گذاران ایرانی، قبل از شروع هرگونه معامله باید مشخص شود که از چه حسابی استفاده خواهد شد، چه اسنادی باید آماده شوند و پرداخت به چه دلیل تجاری انجام می‌پذیرد.</p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-ivory mb-4">در چه زمینه‌هایی پشتیبانی ارائه می‌دهیم؟</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="bg-surface p-5 rounded-xl border border-primary"><strong class="text-ivory block mb-2">شماره مالیاتی</strong><span class="text-sm">آماده‌سازی درخواست شماره شناسایی مالیاتی بالقوه برای اتباع خارجی و کنترل اسناد بر اساس نوع تراکنش.</span></div>
          <div class="bg-surface p-5 rounded-xl border border-primary"><strong class="text-ivory block mb-2">حساب بانکی شخصی</strong><span class="text-sm">آماده‌سازی پیش از درخواست از نظر پاسپورت، آدرس، اطلاعات مالیاتی و اقامتی.</span></div>
          <div class="bg-surface p-5 rounded-xl border border-primary"><strong class="text-ivory block mb-2">حساب بانکی شرکتی</strong><span class="text-sm">آماده‌سازی پرونده برای اسناد ثبت شرکت، حق امضا، ساختار شراکت و مصاحبه بانکی.</span></div>
          <div class="bg-surface p-5 rounded-xl border border-primary"><strong class="text-ivory block mb-2">پرونده تراکنش مالی</strong><span class="text-sm">تنظیم شرح تراکنش، قراردادها و اسناد پشتیبان برای سرمایه‌گذاری، خرید ملک یا پرداخت‌های تجاری.</span></div>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-ivory mb-4">برنامه‌ریزی برای دریافت شماره مالیاتی چگونه است؟</h2>
        <p>در اداره مالیات دیجیتال سازمان امور مالیاتی، صفحه‌ای برای درخواست شماره شناسایی مالیاتی بالقوه برای اتباع خارجی وجود دارد. در این درخواست مهم است که اطلاعات هویتی، پاسپورت، تماس و آدرس دقیق و با یکدیگر سازگار باشند. برای افرادی که دارای شماره ملی اتباع خارجی در ترکیه هستند، اطلاعات هویتی مورد استفاده ممکن است بسته به نوع تراکنش متفاوت باشد.</p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-ivory mb-4">چرا همه نمی‌توانند نتیجه یکسانی در افتتاح حساب بانکی بگیرند؟</h2>
        <p class="mb-4">سیاست‌های پذیرش مشتری و کنترل انطباق (KYC) در بانک‌های مختلف برای مشتریان خارجی یکسان نیست. در حالی که یک بانک ممکن است تنها با پاسپورت و شماره مالیاتی کار را پیش ببرد، بانک دیگر ممکن است مدارک اضافی در مورد اثبات آدرس، کارت اقامت، گواهی درآمد، اسناد شرکتی یا منبع وجوه درخواست کند.</p>
        <p>بنابراین، به جای این رویکرد که «کدام بانک قطعا حساب باز می‌کند؟»، آماده‌سازی پرونده اسنادی مناسب با وضعیت شخص و هدف تراکنش، روشی بسیار منطقی‌تر است.</p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-ivory mb-4">نکات ویژه‌ای که سرمایه‌گذاران ایرانی باید به آن توجه کنند</h2>
        <ul class="list-disc list-inside space-y-2 text-ivory/70">
          <li>آماده بودن قراردادها و اسنادی که دلیل تجاری سرمایه‌گذاری یا پرداخت را نشان می‌دهند</li>
          <li>تفکیک هدف استفاده از حساب شخصی و حساب شرکتی</li>
          <li>قابل توضیح بودن منبع وجوه و زنجیره پرداخت</li>
          <li>استفاده از رسیدها و توضیحات متناسب با نوع تراکنش، خواه مربوط به املاک، سرمایه شرکت یا پرداخت تجاری باشد</li>
          <li>آمادگی برای ارائه اسناد اضافی KYC/انطباق که ممکن است بانک درخواست کند</li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-ivory mb-4">این فرآیند چگونه پیش می‌رود؟</h2>
        <ol class="space-y-3 text-ivory/70">
          <li><strong class="text-ivory">۱. تعیین هدف تراکنش:</strong> هدف از افتتاح حساب شخصی، شرکتی، سرمایه‌گذاری، املاک یا پرداخت تجاری مشخص می‌شود.</li>
          <li><strong class="text-ivory">۲. بررسی اسناد:</strong> پاسپورت، آدرس، اطلاعات مالیاتی، اسناد شرکتی و مدارک پشتیبان تراکنش مورد بررسی قرار می‌گیرند.</li>
          <li><strong class="text-ivory">۳. آماده‌سازی درخواست:</strong> پرونده بر اساس فرمت‌های درخواستی بانک یا نهاد مربوطه تنظیم می‌شود.</li>
          <li><strong class="text-ivory">۴. اقدامات بعدی:</strong> پس از افتتاح حساب، نیازهایی مانند بانکداری اینترنتی، اعطای مجوزهای شرکتی یا پرداخت‌های سرمایه‌گذاری به‌طور جداگانه برنامه‌ریزی می‌شوند.</li>
        </ol>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-ivory mb-4">سوالات متداول</h2>
        <div class="space-y-3">
          {faq.map(item => (
            <details class="bg-surface p-5 rounded-xl border border-primary">
              <summary class="font-semibold text-ivory cursor-pointer">{item.q}</summary>
              <p class="mt-3 text-sm">{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      
      <section class="pt-7 border-t border-surface">
        <div class="bg-surface/80 border border-primary rounded-2xl p-6 md:p-7 text-center">
          <h2 class="text-2xl md:text-3xl font-bold text-ivory mb-3">وضعیت خود را به سرعت ارزیابی کنیم</h2>
          <p class="text-ivory/70 max-w-2xl mx-auto mb-5">برای یک مشاوره اولیه کوتاه می‌توانید از طریق واتس‌اپ پیام دهید یا برای ارائه اطلاعات دقیق‌تر از صفحه تماس استفاده کنید.</p>
          <div class="flex flex-col sm:flex-row justify-center gap-3">
            <a href="https://wa.me/905392425624" target="_blank" class="inline-flex items-center justify-center gap-2 bg-[#25D366] text-white font-semibold px-6 py-3 rounded-lg hover:scale-[1.02] transition-transform">
              واتس‌اپ ترکیه
            </a>
            <a href="/fa/contact/" class="inline-flex items-center justify-center border border-brand text-brand font-semibold px-6 py-3 rounded-lg hover:bg-brand hover:text-white transition-colors">
              صفحه تماس
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
