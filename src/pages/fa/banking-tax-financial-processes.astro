---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../consts';

const faq = [
  {
    q: 'آیا اتباع خارجی می‌توانند در ترکیه شماره مالیاتی بگیرند؟',
    a: 'بله. سامانه اداره مالیات ترکیه امکان درخواست شماره مالیاتی بالقوه برای اتباع خارجی را فراهم کرده است. اطلاعات هویتی مورد استفاده بسته به وضعیت اقامتی و نوع معامله می‌تواند متفاوت باشد.'
  },
  {
    q: 'آیا یک خارجی می‌تواند در ترکیه حساب بانکی باز کند؟',
    a: 'بانک‌ها می‌توانند برای مشتری خارجی حساب باز کنند، اما شرایط پذیرش در هر بانک متفاوت است. پاسپورت، آدرس، شماره مالیاتی، وضعیت اقامت و اسناد مربوط به منبع وجه ممکن است درخواست شود.'
  },
  {
    q: 'حساب شرکتی با حساب شخصی یکسان است؟',
    a: 'خیر. برای حساب شرکتی، مدارک ثبت شرکت، اطلاعات مالیاتی، صاحبان امضا و ساختار سهامداری نیز بررسی می‌شود.'
  },
  {
    q: 'آیا برای انتقال وجه از ایران به ترکیه یک روش ثابت وجود دارد؟',
    a: 'خیر. سیاست بانک، طرفین معامله، ارز، نوع معامله و کنترل‌های تطبیق می‌تواند روش قابل استفاده را تغییر دهد. بهتر است پیش از انتقال، مسیر و مدارک مورد نیاز روشن شود.'
  },
  {
    q: 'آیا افتتاح حساب بانکی تضمین می‌شود؟',
    a: 'خیر. تصمیم نهایی به سیاست پذیرش مشتری و کنترل‌های داخلی بانک مربوط است. در چارچوب مشاوره می‌توان مدارک و فرآیند درخواست را پیش از مراجعه آماده کرد.'
  }
];
---
<BaseLayout title="حساب بانکی، شماره مالیاتی و امور مالی | Mina Beigi" description="راهنمایی برای اتباع خارجی و سرمایه‌گذاران ایرانی درباره شماره مالیاتی، حساب بانکی شخصی و شرکتی، KYC و آماده‌سازی مدارک مالی در ترکیه." lang="fa">
  <Fragment slot="head">
    <link rel="canonical" href={SITE_URL + "/fa/banking-tax-financial-processes/"} />
    <link rel="alternate" hreflang="tr" href={SITE_URL + "/tr/banka-vergi-finansal-surecler/"} />
    <link rel="alternate" hreflang="fa" href={SITE_URL + "/fa/banking-tax-financial-processes/"} />
    <link rel="alternate" hreflang="x-default" href={SITE_URL + "/tr/banka-vergi-finansal-surecler/"} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faq.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    })} />
  </Fragment>

  <div class="relative py-20 md:py-24 bg-primary border-b border-primary overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/hero-banking-tax-finance.webp')] bg-cover bg-center opacity-75 z-0"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/35 to-primary/10 z-10"></div>
    <div class="container mx-auto px-4 max-w-4xl text-center relative z-20" dir="rtl">
      <nav class="text-sm text-bronze/80 mb-5 flex items-center justify-center gap-2" aria-label="Breadcrumb">
        <a href="/fa/" class="hover:text-brand">خانه</a><span>/</span>
        <a href="/fa/services/" class="hover:text-brand">خدمات</a><span>/</span>
        <span class="text-ivory/60">حساب بانکی، مالیات و امور مالی</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold text-ivory mb-5">حساب بانکی، شماره مالیاتی و امور مالی</h1>
      <p class="text-ivory/80 text-lg max-w-3xl mx-auto">آماده‌سازی و هماهنگی امور شماره مالیاتی، حساب بانکی شخصی و شرکتی و مدارک مالی برای خارجی‌ها و سرمایه‌گذاران ایرانی در ترکیه.</p>
    </div>
  </div>

  <main class="py-12 md:py-16 bg-primary">
    <div class="container mx-auto px-4 max-w-5xl text-ivory/80 leading-relaxed text-lg space-y-10" dir="rtl">
      <section>
        <h2 class="text-3xl font-bold text-ivory mb-4">یکی از رایج‌ترین مشکلات خارجی‌ها در ترکیه: بانک و امور مالی</h2>
        <p class="mb-4">افرادی که در ترکیه شرکت ثبت می‌کنند، ملک می‌خرند، سرمایه‌گذاری می‌کنند یا قصد فعالیت تجاری منظم دارند، خیلی زود با موضوع شماره مالیاتی، حساب بانکی و انتقال وجه روبه‌رو می‌شوند. هر بانک و هر معامله ممکن است الزامات متفاوتی داشته باشد.</p>
        <p>برای سرمایه‌گذاران ایرانی بهتر است قبل از شروع معامله، نوع حساب، اسناد لازم و دلیل تجاری پرداخت به‌طور روشن مشخص شود.</p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-ivory mb-4">حوزه خدمات</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="bg-surface p-5 rounded-xl border border-primary"><strong class="text-ivory block mb-2">شماره مالیاتی</strong><span class="text-sm">آماده‌سازی اطلاعات و مدارک برای درخواست شماره مالیاتی اتباع خارجی.</span></div>
          <div class="bg-surface p-5 rounded-xl border border-primary"><strong class="text-ivory block mb-2">حساب بانکی شخصی</strong><span class="text-sm">بررسی پاسپورت، آدرس، شماره مالیاتی و وضعیت اقامت پیش از مراجعه به بانک.</span></div>
          <div class="bg-surface p-5 rounded-xl border border-primary"><strong class="text-ivory block mb-2">حساب بانکی شرکت</strong><span class="text-sm">آماده‌سازی اسناد ثبت شرکت، صاحبان امضا، سهامداران و پرونده معرفی شرکت.</span></div>
          <div class="bg-surface p-5 rounded-xl border border-primary"><strong class="text-ivory block mb-2">پرونده مالی معامله</strong><span class="text-sm">تنظیم مدارک مربوط به سرمایه‌گذاری، خرید ملک یا پرداخت تجاری.</span></div>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-ivory mb-4">شماره مالیاتی چگونه برنامه‌ریزی می‌شود؟</h2>
        <p>در سامانه دیجیتال اداره مالیات ترکیه امکان درخواست شماره مالیاتی بالقوه برای اتباع خارجی وجود دارد. صحت و هماهنگی اطلاعات پاسپورت، آدرس و اطلاعات تماس اهمیت زیادی دارد و نوع شناسه مورد استفاده با توجه به وضعیت فرد و نوع معامله می‌تواند متفاوت باشد.</p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-ivory mb-4">چرا نتیجه افتتاح حساب برای همه یکسان نیست؟</h2>
        <p class="mb-4">سیاست پذیرش مشتری خارجی و کنترل‌های KYC/تطبیق در بانک‌ها یکسان نیست. برخی بانک‌ها علاوه بر پاسپورت و شماره مالیاتی، مدرک آدرس، کارت اقامت، اطلاعات درآمد، اسناد شرکت یا توضیح درباره منبع وجه را نیز درخواست می‌کنند.</p>
        <p>به همین دلیل، به جای جستجوی «بانکی که حتماً حساب باز کند»، بهتر است پرونده‌ای متناسب با وضعیت شخص و هدف مالی آماده شود.</p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-ivory mb-4">نکات مهم برای سرمایه‌گذاران ایرانی</h2>
        <ul class="list-disc list-inside space-y-2 text-ivory/70">
          <li>قرارداد و اسناد توضیح‌دهنده دلیل تجاری پرداخت آماده باشد</li>
          <li>کاربرد حساب شخصی و حساب شرکت از هم تفکیک شود</li>
          <li>منبع وجه و زنجیره پرداخت قابل توضیح باشد</li>
          <li>برای خرید ملک، سرمایه شرکت یا پرداخت تجاری از توضیحات و رسیدهای متناسب استفاده شود</li>
          <li>برای درخواست اسناد تکمیلی KYC و تطبیق بانکی آمادگی وجود داشته باشد</li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-ivory mb-4">مراحل کار</h2>
        <ol class="space-y-3 text-ivory/70">
          <li><strong class="text-ivory">۱. تعیین هدف:</strong> حساب شخصی، حساب شرکتی، سرمایه‌گذاری، ملک یا پرداخت تجاری مشخص می‌شود.</li>
          <li><strong class="text-ivory">۲. کنترل مدارک:</strong> پاسپورت، آدرس، مالیات، اسناد شرکت و مدارک معامله بررسی می‌شود.</li>
          <li><strong class="text-ivory">۳. آماده‌سازی درخواست:</strong> پرونده با توجه به الزامات بانک یا مرجع مربوطه تنظیم می‌شود.</li>
          <li><strong class="text-ivory">۴. مرحله بعد:</strong> بانکداری اینترنتی، اختیار امضا یا پرداخت سرمایه‌گذاری در صورت نیاز جداگانه برنامه‌ریزی می‌شود.</li>
        </ol>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-ivory mb-4">سوالات متداول</h2>
        <div class="space-y-3">
          {faq.map(item => (
            <details class="bg-surface p-5 rounded-xl border border-primary">
              <summary class="font-semibold text-ivory cursor-pointer">{item.q}</summary>
              <p class="mt-3 text-sm">{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      
      <section class="pt-7 border-t border-surface">
        <div class="bg-surface/80 border border-primary rounded-2xl p-6 md:p-7 text-center" dir="rtl">
          <h2 class="text-2xl md:text-3xl font-bold text-ivory mb-3">برای ارزیابی سریع با ما در تماس باشید</h2>
          <p class="text-ivory/70 max-w-2xl mx-auto mb-5">برای یک بررسی اولیه از طریق واتساپ پیام دهید یا برای ارسال اطلاعات کامل‌تر از صفحه تماس استفاده کنید.</p>
          <div class="flex flex-col sm:flex-row justify-center gap-3">
            <a href="https://wa.me/989125102088" target="_blank" class="inline-flex items-center justify-center gap-2 bg-[#25D366] text-white font-semibold px-6 py-3 rounded-lg hover:scale-[1.02] transition-transform">واتساپ ایران</a>
            <a href="/fa/contact/" class="inline-flex items-center justify-center border border-brand text-brand font-semibold px-6 py-3 rounded-lg hover:bg-brand hover:text-white transition-colors">صفحه تماس</a>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
