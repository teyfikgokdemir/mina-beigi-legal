---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../consts';
---
<BaseLayout title="اجازه کار در ترکیه برای ایرانیان" description="اجازه کار در ترکیه برای ایرانیان؛ بررسی شرایط، آماده‌سازی مدارک، تمدید و هماهنگی درخواست برای کارکنان، مدیران و شرکای تجاری. بررسی شرایط، آماده‌سازی مدارک و هماهنگی درخواست مجوز کار برای اتباع خارجی." lang="fa">
  <Fragment slot="head">
    <link rel="canonical" href={SITE_URL + "/fa/work-permit/"} />
    <link rel="alternate" hreflang="tr" href={SITE_URL + "/tr/calisma-izni/"} />
    <link rel="alternate" hreflang="fa" href={SITE_URL + "/fa/work-permit/"} />
    <link rel="alternate" hreflang="x-default" href={SITE_URL + "/tr/calisma-izni/"} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context":"https://schema.org",
      "@type":"FAQPage",
      "mainEntity":[
        {"@type":"Question","name":"آیا ایرانیان می‌توانند در ترکیه اجازه کار بگیرند؟","acceptedAnswer":{"@type":"Answer","text":"بله. اتباع ایرانی نیز می‌توانند برای اجازه کار ترکیه درخواست دهند. شرایط بر اساس وضعیت متقاضی، کارفرما، شغل و معیارهای روز بررسی می‌شود."}},
        {"@type":"Question","name":"اجازه کار ترکیه چقدر زمان می‌برد؟","acceptedAnswer":{"@type":"Answer","text":"زمان رسیدگی بسته به نوع درخواست، مدارک و ارزیابی مرجع ذی‌صلاح متفاوت است. «کمتر از یک ماه، تضمینی». نتیجه رسمی درخواست و زمان رسیدگی بر اساس وضعیت پرونده، شرایط کارفرما و ارزیابی مرجع ذی‌صلاح تعیین می‌شود."}},
        {"@type":"Question","name":"آیا شریک شرکت بودن به‌تنهایی اجازه کار می‌دهد؟","acceptedAnswer":{"@type":"Answer","text":"خیر. شراکت در شرکت و اجازه کار دو موضوع جداگانه هستند و اجازه کار جداگانه بررسی می‌شود."}}
      ]
    })} />
  </Fragment>

  <div class="relative py-20 md:py-24 bg-primary border-b border-primary overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-75 z-0" style="background-image: url('/images/srv-work.jpg');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/35 to-primary/10 z-10"></div>
    <div class="container mx-auto px-4 max-w-4xl text-center relative z-20" dir="rtl">
      <nav class="text-sm text-bronze/80 mb-5 flex items-center justify-center gap-2" aria-label="Breadcrumb">
        <a href="/fa/" class="hover:text-brand">خانه</a><span>/</span>
        <a href="/fa/services/" class="hover:text-brand">خدمات</a><span>/</span>
        <span class="text-ivory/60" aria-current="page">فرآیندهای مجوز کار</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold text-ivory mb-5">اجازه کار در ترکیه برای ایرانیان</h1>
      <p class="text-ivory/75 max-w-2xl mx-auto">بررسی شرایط، آماده‌سازی مدارک و هماهنگی درخواست مجوز کار برای اتباع خارجی.</p>
    </div>
  </div>

  <main class="py-12 md:py-16 bg-primary">
    <div class="container mx-auto px-4 max-w-5xl mb-8" dir="rtl">
      <div class="rounded-2xl border border-brand/40 bg-surface p-5 text-ivory/80 leading-relaxed">
        <h2 class="text-2xl font-bold text-ivory mb-2">اجازه کار در ترکیه</h2>
        <p><strong class="text-ivory">«کمتر از یک ماه، تضمینی»</strong> عبارتی است که در محتوای معرفی خود مینا بیگی برای خدمت اجازه کار استفاده شده است. نتیجه رسمی و زمان رسیدگی نهایی به وضعیت پرونده، شرایط کارفرما و ارزیابی مرجع ذی‌صلاح بستگی دارد.</p>
      </div>
    </div>
    <div class="container mx-auto px-4 max-w-5xl text-ivory/80 leading-relaxed text-lg space-y-10" dir="rtl">
      
<section><h2 class="text-3xl font-bold text-ivory mb-4">مجوز کار؛ پرونده باید با وضعیت شخص و کارفرما هماهنگ باشد</h2><p>شرایط مجوز کار بر اساس وضعیت متقاضی، ساختار کارفرما، نوع فعالیت شرکت و معیارهای روز متفاوت است. بنابراین پیش از اقدام، بررسی وضعیت و مدارک اهمیت زیادی دارد.</p></section>
<section><h2 class="text-2xl font-bold text-ivory mb-4">مناسب برای</h2><ul class="list-disc list-inside space-y-2 text-ivory/70"><li>اتباع خارجی که برای یک کارفرمای ترکیه‌ای کار خواهند کرد</li><li>شرکای خارجی که در شرکت خود فعالیت عملی دارند</li><li>افرادی که قصد تمدید یا تغییر وضعیت مجوز خود را دارند</li></ul></section>
<section><h2 class="text-2xl font-bold text-ivory mb-4">مراحل</h2><ol class="space-y-3 text-ivory/70"><li><strong class="text-ivory">۱. ارزیابی اولیه:</strong> اطلاعات فرد و کارفرما با معیارهای جاری تطبیق داده می‌شود.</li><li><strong class="text-ivory">۲. مدارک:</strong> مدارک شخصی، شرکتی و ترجمه‌های لازم آماده می‌شود.</li><li><strong class="text-ivory">۳. هماهنگی درخواست:</strong> مسیر مناسب و ترتیب مراحل مشخص می‌شود.</li><li><strong class="text-ivory">۴. ادامه پرونده:</strong> در صورت نیاز به مدرک تکمیلی، پرونده مجدداً بررسی می‌شود.</li></ol></section>
<section><h2 class="text-2xl font-bold text-ivory mb-4">نکات مهم</h2><p>معیارهای مرتبط با کارفرما و متقاضی ممکن است تغییر کنند. نباید بر اساس سهمیه، سرمایه یا زمان نتیجه ثابت تصمیم گرفت؛ شرایط روز باید برای هر پرونده جداگانه بررسی شود.</p></section>
<section><h2 class="text-2xl font-bold text-ivory mb-4">سوالات متداول</h2><div class="space-y-3"><details class="bg-surface p-5 rounded-xl"><summary class="font-semibold text-ivory cursor-pointer">آیا زمان نتیجه قطعی است؟</summary><p class="mt-3 text-sm">خیر. نوع درخواست، حجم کاری مرجع و نیاز به مدارک تکمیلی می‌تواند زمان را تغییر دهد.</p></details><details class="bg-surface p-5 rounded-xl"><summary class="font-semibold text-ivory cursor-pointer">آیا شریک شرکت بودن به‌تنهایی اجازه کار می‌دهد؟</summary><p class="mt-3 text-sm">خیر. شریک بودن و مجوز کار دو موضوع جداگانه هستند.</p></details><details class="bg-surface p-5 rounded-xl"><summary class="font-semibold text-ivory cursor-pointer">آیا اقامت به معنای اجازه کار است؟</summary><p class="mt-3 text-sm">هر نوع اقامت حق کار ایجاد نمی‌کند و وضعیت شخص باید جداگانه بررسی شود.</p></details><details class="bg-surface p-5 rounded-xl"><summary class="font-semibold text-ivory cursor-pointer">مدارک خارجی چه می‌شوند؟</summary><p class="mt-3 text-sm">بسته به نوع درخواست، ترجمه رسمی و تایید نوتر ممکن است لازم باشد.</p></details></div></section>

      
      <section class="pt-7 border-t border-surface">
        <div class="bg-surface/80 border border-primary rounded-2xl p-6 md:p-7 text-center" dir="rtl">
          <h2 class="text-2xl md:text-3xl font-bold text-ivory mb-3">برای ارزیابی سریع با ما در تماس باشید</h2>
          <p class="text-ivory/70 max-w-2xl mx-auto mb-5">برای یک بررسی اولیه از طریق واتساپ پیام دهید یا برای ارسال اطلاعات کامل‌تر از صفحه تماس استفاده کنید.</p>
          <div class="flex flex-col sm:flex-row justify-center gap-3">
            <a href="https://wa.me/989125102088" target="_blank" class="inline-flex items-center justify-center gap-2 bg-[#25D366] text-white font-semibold px-6 py-3 rounded-lg hover:scale-[1.02] transition-transform">
              واتساپ ایران
            </a>
            <a href="/fa/contact/" class="inline-flex items-center justify-center border border-brand text-brand font-semibold px-6 py-3 rounded-lg hover:bg-brand hover:text-white transition-colors">
              صفحه تماس
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
