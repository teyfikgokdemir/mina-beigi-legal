---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../consts';
---
<BaseLayout title="مشاوره مجوز کار در ترکیه | ایرانیان و اتباع خارجی" description="درخواست مجوز کار در ترکیه، تمدید، آماده‌سازی مدارک و هماهنگی روندها. مشاوره تخصصی مجوز کار برای کارمندان ایرانی، شرکای خارجی شرکت‌ها و کارفرمایان." lang="fa">
  <Fragment slot="head">
    <link rel="canonical" href={SITE_URL + "/fa/work-permit/"} />
    <link rel="alternate" hreflang="tr" href={SITE_URL + "/tr/calisma-izni/"} />
    <link rel="alternate" hreflang="fa" href={SITE_URL + "/fa/work-permit/"} />
    <link rel="alternate" hreflang="x-default" href={SITE_URL + "/tr/calisma-izni/"} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context":"https://schema.org",
      "@type":"FAQPage",
      "mainEntity":[
        {"@type":"Question","name":"آیا شهروندان ایرانی می‌توانند در ترکیه مجوز کار دریافت کنند؟","acceptedAnswer":{"@type":"Answer","text":"بله. شهروندان ایرانی نیز می‌توانند برای دریافت مجوز کار در ترکیه درخواست دهند. شرایط درخواست بر اساس وضعیت فرد، ساختار کارفرما، شغل و معیارهای ارزیابی به‌روز بررسی می‌شود."}},
        {"@type":"Question","name":"روند دریافت مجوز کار در ترکیه چقدر طول می‌کشد؟","acceptedAnswer":{"@type":"Answer","text":"این مدت بسته به نوع درخواست، محتوای پرونده، نیاز به مدارک اضافی و ارزیابی مقامات ذی‌صلاح متغیر است. 'کمتر از ۱ ماه، تضمینی'. نتیجه رسمی و زمان پردازش درخواست به وضعیت پرونده، شرایط کارفرما و نظر مقام مسئول بستگی دارد."}},
        {"@type":"Question","name":"آیا شراکت در یک شرکت به صورت خودکار مجوز کار به همراه دارد؟","acceptedAnswer":{"@type":"Answer","text":"شراکت در شرکت به تنهایی حق کار خودکار ایجاد نمی‌کند؛ درخواست مجوز کار باید به طور جداگانه ارزیابی شود."}},
        {"@type":"Question","name":"آیا اجازه اقامت حق کار نیز به همراه دارد؟","acceptedAnswer":{"@type":"Answer","text":"هر نوع اجازه اقامتی حق کار ایجاد نمی‌کند. حق کار با توجه به وضعیت فرد و قوانین مربوط به مجوز کار به صورت جداگانه بررسی می‌شود."}}
      ]
    })} />
  </Fragment>

  <div class="relative py-20 md:py-24 bg-primary border-b border-primary overflow-hidden" dir="rtl">
    <div class="absolute inset-0 bg-cover bg-center opacity-75 z-0" style="background-image: url('/images/srv-work.jpg');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/35 to-primary/10 z-10"></div>
    <div class="container mx-auto px-4 max-w-4xl text-center relative z-20">
      <nav class="text-sm text-bronze/80 mb-5 flex items-center justify-center gap-2" aria-label="Breadcrumb">
        <a href="/fa/" class="hover:text-brand">صفحه اصلی</a><span>/</span>
        <a href="/fa/services/" class="hover:text-brand">خدمات</a><span>/</span>
        <span class="text-ivory/60" aria-current="page">روندهای مجوز کار</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold text-ivory mb-5">روندهای مجوز کار</h1>
      <p class="text-ivory/75 max-w-2xl mx-auto">ارزیابی صلاحیت مجوز کار، آماده‌سازی مدارک و هماهنگی درخواست برای اتباع خارجی.</p>
    </div>
  </div>

  <main class="py-12 md:py-16 bg-primary" dir="rtl">
    <div class="container mx-auto px-4 max-w-5xl text-ivory/80 leading-relaxed text-lg space-y-10">
      
<section>
  <div class="mb-6 rounded-2xl border border-brand/40 bg-surface p-5 text-center">
    <h2 class="text-2xl md:text-3xl font-bold text-ivory mb-3">مجوز کار تضمینی در ترکیه در کمتر از ۱ ماه</h2>
    <p class="text-ivory/75 max-w-4xl mx-auto">نتیجه رسمی و زمان پردازش درخواست بر اساس وضعیت پرونده، شرایط کارفرما و ارزیابی مقام ذی‌صلاح تعیین می‌شود.</p>
  </div>
  <h2 class="text-3xl font-bold text-ivory mb-4">ساختار صحیح پرونده در مجوز کار</h2>
  <p>شرایط مجوز کار ممکن است بر اساس وضعیت متقاضی، ساختار کارفرما، فعالیت‌های شرکت و معیارهای ارزیابی فعلی متفاوت باشد. به همین دلیل، بررسی صلاحیت و مدارک پیش از ثبت درخواست از اهمیت بالایی برخوردار است.</p>
</section>
<section>
  <h2 class="text-2xl font-bold text-ivory mb-4">چه کسانی واجد شرایط هستند؟</h2>
  <ul class="list-disc list-inside space-y-2 text-ivory/70"><li>اتباع خارجی که قرار است نزد یک کارفرما در ترکیه کار کنند</li><li>شرکای خارجی که قصد فعالیت مستمر در شرکت خود را دارند</li><li>افرادی که قصد تمدید مجوز فعلی یا تغییر وضعیت خود را دارند</li></ul>
</section>
<section>
  <h2 class="text-2xl font-bold text-ivory mb-4">مراحل</h2>
  <ol class="space-y-3 text-ivory/70">
    <li><strong class="text-ivory">۱. ارزیابی اولیه:</strong> تطابق اطلاعات فردی و کارفرما با معیارهای فعلی بررسی می‌شود.</li>
    <li><strong class="text-ivory">۲. آماده‌سازی مدارک:</strong> مدارک شخصی و شرکتی، ترجمه‌ها و اسناد پشتیبان لازم آماده می‌گردد.</li>
    <li><strong class="text-ivory">۳. هماهنگی درخواست:</strong> مسیر درخواست و ترتیب پردازش تعیین شده و یکپارچگی پرونده کنترل می‌شود.</li>
    <li><strong class="text-ivory">۴. مراحل بعدی:</strong> در صورت نیاز به مدارک اضافی یا بروزرسانی، پرونده مجدداً بررسی می‌شود.</li>
  </ol>
</section>
<section><h2 class="text-2xl font-bold text-ivory mb-4">نکات قابل توجه</h2><p>معیارهای مربوط به کارفرما و کارمند ممکن است در طول زمان تغییر کنند. بنابراین، نباید بر اساس سهمیه ثابت، سرمایه مشخص یا زمان نتیجه‌گیری قطعی عمل کرد؛ شرایط فعلی باید با توجه به هر پرونده ارزیابی شود.</p></section>
<section>
  <h2 class="text-2xl font-bold text-ivory mb-4">سوالات متداول</h2>
  <div class="space-y-3">
    <details class="bg-surface p-5 rounded-xl"><summary class="font-semibold text-ivory cursor-pointer">آیا زمان دقیقی برای اعلام نتیجه مجوز کار وجود دارد؟</summary><p class="mt-3 text-sm">خیر. زمان پردازش ممکن است بسته به نوع درخواست، حجم کاری سازمان و نیاز به مدارک اضافی متفاوت باشد.</p></details>
    <details class="bg-surface p-5 rounded-xl"><summary class="font-semibold text-ivory cursor-pointer">آیا شراکت در شرکت به‌صورت خودکار حق کار به همراه دارد؟</summary><p class="mt-3 text-sm">خیر. شراکت در شرکت و مجوز کار دو موضوع مجزا برای ارزیابی هستند.</p></details>
    <details class="bg-surface p-5 rounded-xl"><summary class="font-semibold text-ivory cursor-pointer">آیا اجازه اقامت حق کار نیز به همراه دارد؟</summary><p class="mt-3 text-sm">هر نوع اجازه اقامتی حق کار ایجاد نمی‌کند؛ وضعیت فرد باید جداگانه بررسی شود.</p></details>
    <details class="bg-surface p-5 rounded-xl"><summary class="font-semibold text-ivory cursor-pointer">اگر مدارک به زبان خارجی باشند؟</summary><p class="mt-3 text-sm">بسته به نوع فرآیند، ممکن است ترجمه رسمی و تأیید دفترخانه (نوتر) مورد نیاز باشد.</p></details>
  </div>
</section>

      
      <section class="pt-7 border-t border-surface">
        <div class="bg-surface/80 border border-primary rounded-2xl p-6 md:p-7 text-center">
          <h2 class="text-2xl md:text-3xl font-bold text-ivory mb-3">بیایید شرایط شما را به سرعت ارزیابی کنیم</h2>
          <p class="text-ivory/70 max-w-2xl mx-auto mb-5">برای یک مشاوره اولیه کوتاه می‌توانید از طریق واتس‌اپ پیام دهید یا برای ارائه اطلاعات دقیق‌تر از صفحه تماس استفاده کنید.</p>
          <div class="flex flex-col sm:flex-row justify-center gap-3">
            <a href="https://wa.me/905392425624" target="_blank" class="inline-flex items-center justify-center gap-2 bg-[#25D366] text-white font-semibold px-6 py-3 rounded-lg hover:scale-[1.02] transition-transform">
              واتس‌اپ ترکیه
            </a>
            <a href="/fa/contact/" class="inline-flex items-center justify-center border border-brand text-brand font-semibold px-6 py-3 rounded-lg hover:bg-brand hover:text-white transition-colors">
              صفحه تماس
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
